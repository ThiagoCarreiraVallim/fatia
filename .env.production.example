# ============================================================
# Variáveis de produção (Dokploy).
#
# Não commitar este arquivo preenchido. Configurar tudo no painel do
# Dokploy → Project → Environment.
# ============================================================

# ----- Domínio (raiz, sem subdomínio) -----
# Tudo é deduzido daqui:
#   fat.ia.br       → site institucional + /claude-connect (estático, nginx)
#   www.fat.ia.br   → redireciona para o apex
#   app.fat.ia.br   → PWA
#   api.fat.ia.br   → API + endpoint MCP em /mcp
#   auth.fat.ia.br  → Logto
DOMAIN=fat.ia.br

# ============================================================
# Postgres (criado fora do compose, via Dokploy → Database)
# ============================================================
# Use o hostname interno que o Dokploy gerou (algo como "fatia-postgres")
# OU o IP da rede Docker (visível em "Connection details" do banco).
#
# Crie DUAS databases dentro do mesmo Postgres:
#   - fatia  (aplicação)
#   - logto  (identity provider)
#
# Comandos rápidos depois de criar a "Database" no Dokploy:
#   docker exec -it <postgres-container> psql -U <user> -c 'CREATE DATABASE fatia;'
#   docker exec -it <postgres-container> psql -U <user> -c 'CREATE DATABASE logto;'

# DSN da database principal (usada pelo NestJS / Prisma)
DATABASE_URL=postgresql://fatia:CHANGE_ME@fatia-postgres:5432/fatia

# DSN da database do Logto (mesma instância, database separada)
LOGTO_DB_URL=postgresql://fatia:CHANGE_ME@fatia-postgres:5432/logto

# ============================================================
# Logto (Identity Provider — ADR 008)
# ============================================================

# Versão da imagem svhd/logto. Manter pin pra evitar quebra de breaking change.
LOGTO_VERSION=1.30

# Identifier do "API Resource" criado no console do Logto.
# Use o mesmo valor do subdomínio da API (default: https://api.${DOMAIN})
# Se quiser sobrescrever, descomente:
# LOGTO_AUDIENCE=https://api.fatia.app.br

# Credenciais do "Application" criado no console do Logto, tipo "Traditional Web".
# Preencher após criar a Application no console (auth.${DOMAIN}/admin) na primeira vez.
LOGTO_APP_ID=replace_with_app_id_from_logto_console
LOGTO_APP_SECRET=replace_with_app_secret_from_logto_console

# Secret de 32+ bytes pra criptografar o cookie de sessão do Next.js.
# Gerar: openssl rand -base64 32
LOGTO_COOKIE_SECRET=replace_with_32_byte_random_string

# App "Machine-to-Machine" com a role "Logto Management API access". Apagar a conta
# (LGPD art. 18) remove a identidade no Logto com ela, e o primeiro acesso lê daqui o
# e-mail e o nome da pessoa. Vazio = a identidade sobra no Logto e a conta nasce com
# e-mail provisório (o convite por e-mail não a reconhece).
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# ============================================================
# E-mail do Logto — cadastro verificado e "esqueci minha senha"
# Aplicado no Logto por `pnpm logto:bootstrap` (rode de novo ao trocar).
# Qualquer SMTP serve (Resend, Amazon SES, Postmark…). Vazio = sem
# recuperação de senha.
# ============================================================
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASS=CHANGE_ME
EMAIL_SMTP_SECURE=true
EMAIL_FROM=Fatia <nao-responda@fat.ia.br>

# E-mail que a própria API manda (convite de comunidade). O mesmo SMTP, em URL;
# smtps:// para a porta 465. Vazio = o convite não sai por e-mail, só o link.
# MAIL_SMTP_URL=smtps://resend:CHANGE_ME@smtp.resend.com:465

# ============================================================
# Observabilidade (issue #39) — auto-hospedada, sem conta externa
# ============================================================

# Endpoint OTLP/HTTP do collector, alcançável pela `dokploy-network`.
# VAZIO = a API não exporta nada e sobe normalmente — útil para implantar a aplicação
# antes do stack de observabilidade.
# Passo a passo em docs/OPERATIONS.md §Observabilidade → "Subir no Dokploy".
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fatia-api

# ============================================================
# Cobrança — Asaas (grupo #158 e plano PRO pela web, ADR 024)
# ============================================================
#
# Vazio = cobrança desligada: o checkout do PRO pela web responde 503. Com
# AI_REQUIRES_PLAN=true e o Asaas vazio, ninguém consegue assinar pela web.
#
# ⚠️ A chave de produção NÃO é preenchida neste arquivo de exemplo nem commitada
# em lugar nenhum: ela entra como variável de ambiente do serviço no Dokploy.
# Este arquivo é exemplo versionado; uma chave aqui é uma chave publicada.
# ASAAS_BASE_URL=https://api.asaas.com
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
#
# Webhook no painel do Asaas: https://api.<DOMAIN>/api/billing/webhooks/asaas,
# com o mesmo token, eventos de cobrança e de assinatura.

# ============================================================
# Plano Free / PRO (ADR 024)
# ============================================================
# A instância pública exige o PRO para a IA hospedada. Self-host deixa false.
# AI_REQUIRES_PLAN=true
# BILLING_PRO_MONTHLY_CENTS=1990
# BILLING_PRO_YEARLY_CENTS=17900
# Assento de comunidade por mês (ADR 025)
# BILLING_SEAT_MONTHLY_CENTS=1490
#
# RevenueCat (compra no app). Webhook: https://api.<DOMAIN>/api/billing/webhooks/revenuecat
# REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_SECRET_KEY=
# REVENUECAT_ENTITLEMENT_ID=pro

# ============================================================
# Link universal do convite no app nativo (Fase 5) — servido pela web
# ============================================================
# Sem os dois, /.well-known/* responde 404 e o link de convite abre o PWA.
# O build do app precisa de APP_LINKS_HOST=app.<DOMAIN> (apps/mobile/.env.example).
# APPLE_TEAM_ID=
# Impressão SHA-256 do certificado de assinatura (Play Console); várias, por vírgula.
# ANDROID_CERT_SHA256=

# --- Variáveis do Compose service da observabilidade (o outro, não o da aplicação) ---
# GRAFANA_USER=admin
# ⚠️ Trocar ANTES do primeiro deploy: este Grafana lê log de produção num subdomínio
# público. Gerar com: openssl rand -base64 24
# GRAFANA_PASSWORD=replace_with_random_string

# ============================================================
# Imagens (opcional)
# ============================================================
# Se for buildar via Dokploy direto do Git, deixar default.
# Se for usar registry externo (GHCR/Docker Hub), referenciar aqui.
# API_IMAGE=ghcr.io/seu-usuario/fatia-api:latest
# WEB_IMAGE=ghcr.io/seu-usuario/fatia-web:latest
# SITE_IMAGE=ghcr.io/seu-usuario/fatia-site:latest
# AGENT_IMAGE=ghcr.io/seu-usuario/fatia-agent:latest

# ============================================================
# Agente de IA (apps/agent, ADR 015)
#
# Serviço `agent` do compose de produção, só na rede interna. A `api` fala com
# ele por AGENT_BASE_URL; ele fala com o /mcp da `api` pelo nome do serviço.
# AGENT_BASE_URL vazia = chat e foto do prato somem da interface.
# ============================================================
# AGENT_BASE_URL=http://agent:8100
# AGENT_API_KEY=  # openssl rand -hex 32 — o MESMO valor vai para api e agent
# AGENT_CHECKPOINT_DATABASE_URL=postgresql://fatia:SENHA@fatia-postgres:5432/fatia
# MCP_BASE_URL=http://api:3000/mcp  # default do compose
#
# Destino revisado (allowed_models.py): OpenRouter servindo o GLM 5.3 Flash.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=  # obrigatória fora de localhost — sem ela o agente degrada antes do 401
# AI_MODEL_TEXT=z-ai/glm-5.3-flash
# AI_MODEL_VISION=z-ai/glm-5.3-flash
# AI_MODEL_EMBEDDING=
# AI_MODEL_TRANSCRIPTION=  # nenhum modelo revisado ainda: vazio = sem microfone no chat
# AI_TIMEOUT_S=120

# ⚠️ Destino e modelo de produção NÃO são livres. As duas listas revisadas como
# subprocessador ficam no código (apps/agent/src/fatia_agent/allowed_models.py),
# e não aqui: ALLOWED_HOSTS para AI_BASE_URL e ALLOWED_MODELS para AI_MODEL_*.
# Trocar qualquer uma pelo painel troca quem recebe a foto do prato, e a
# /privacy nomeia esse terceiro. Fora das listas, a capacidade recusa a chamada
# antes de qualquer byte sair (ADR 020, issue #136). Autorizar um destino ou um
# modelo novo é um PR, que é onde a revisão do texto acontece.

# ⚠️ NO PAINEL DO AI GATEWAY: desligue "Logs".
# O Cloudflare AI Gateway grava corpo de requisição e de resposta POR PADRÃO —
# a foto do prato e a resposta do modelo ficam legíveis no painel dele. O agente
# já manda `cf-aig-collect-log: false` em toda chamada, o que cobre o que sai do
# nosso código; a opção do painel cobre o que não sair. Faça as duas: a
# /privacy afirma ao titular que o conteúdo não é registrado.

# --- Custo e cota da IA hospedada (issue #135) -------------------------------
# Lidas pela API, não pelo agente: quem aplica a cota é quem tem o banco.
# Preço em MICRO-UNIDADES por MILHÃO de unidades — US$ 3,00/M se escreve 3000000.
# AI_PRICE_TABLE={"gateway/modelo":{"in":3000000,"out":15000000}}
#
# Tetos diários em micro-unidades, janela de dia corrido UTC. O PRO tem preço
# fixo (ADR 024) e não repassa consumo, então a cota é a defesa de margem.
# Preencher ANTES de ligar AI_REQUIRES_PLAN=true.
# AI_QUOTA_DAILY_MICROS=0
# AI_QUOTA_GLOBAL_DAILY_MICROS=0
#
# Tolerância de chamadas cujo custo não deu para saber (modelo fora da
# AI_PRICE_TABLE), na mesma janela. Custo desconhecido entra na soma como 0, e
# uma soma que fica em 0 libera a cota para sempre — a contenção se desligaria
# sozinha justamente quando a medição se perdeu. Aqui 0 NÃO desliga: significa
# "nenhuma tolerância". A guarda só vale com algum teto acima ligado.
# AI_QUOTA_UNPRICED_DAILY_CALLS=20

# ============================================================
# Admin inicial (informativo — usuário criado no console do Logto)
# ============================================================
ADMIN_EMAIL=admin@fatia.app.br
ADMIN_NAME=Admin
