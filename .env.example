# ============================================================
# Banco de dados
# Mesmo Postgres serve a database principal (fatia) e a do Logto (logto).
# ============================================================
POSTGRES_USER=fatia
POSTGRES_PASSWORD=fatia_dev
POSTGRES_DB=fatia
POSTGRES_PORT=5432

DATABASE_URL=postgresql://fatia:fatia_dev@localhost:5432/fatia

# ============================================================
# Logto (Identity Provider — ADR 008)
# ============================================================

# URL pública do Logto. Em desenvolvimento: http://localhost:3001
# Em produção (Dokploy): https://auth.fatia.dominio
LOGTO_ENDPOINT=http://localhost:3001

# URL do console admin do Logto.
# Em produção pode ser uma rota interna ou subdomínio separado.
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# Portas locais (só usadas em dev local com docker compose).
# Mantém os defaults do Logto pra evitar mismatch entre o admin SPA e a Management API.
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002

# ID e secret do "App" criado no console do Logto para o PWA (tipo: Traditional Web).
# Preencher após criar o app no console na primeira vez.
LOGTO_APP_ID=replace_after_creating_app_in_logto_console
LOGTO_APP_SECRET=replace_after_creating_app_in_logto_console

# App "Traditional Web" criado no Logto para o OAuth facade do MCP.
# Redirect URI a configurar no Logto: {API_PUBLIC_URL}/oauth/callback
LOGTO_MCP_APP_ID=replace_after_creating_mcp_app_in_logto_console
LOGTO_MCP_APP_SECRET=replace_after_creating_mcp_app_in_logto_console

# OPCIONAL — App "Machine-to-Machine" no Logto, com a role "Logto Management API access".
# Usado só por delete_my_account (DELETE /users/me) para apagar a identidade do usuário
# no Logto junto da conta. Sem isso a conta e TODOS os dados locais são apagados
# normalmente; só a identidade sobra no Logto, sem dar acesso a nada (issue #95).
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
# Resource da Management API. Só mude se sua instância usa um tenant id customizado.
LOGTO_MANAGEMENT_RESOURCE=https://default.logto.app/api

# Secret aleatório para criptografar cookies de sessão no Next.js.
# Gerar com: openssl rand -base64 32
LOGTO_COOKIE_SECRET=replace_with_32_byte_random_string

# Base URL do PWA (para callbacks OAuth).
# Em produção: https://app.fatia.dominio
LOGTO_BASE_URL=http://localhost:3030

# Audience que a API NestJS valida nos JWTs.
# Configurar no Logto como "API resource" e usar o identifier aqui.
# Exemplo: https://api.fatia.dominio
LOGTO_AUDIENCE=https://api.fatia.local

# ============================================================
# API
# ============================================================
NODE_ENV=development
API_PORT=3000

# Origem permitida no CORS
WEB_ORIGIN=http://localhost:3030

# ============================================================
# Observabilidade (issue #39) — OpenTelemetry, tudo auto-hospedado
# ============================================================

# Endpoint OTLP/HTTP do collector. VAZIO = instrumentação inerte: sem exportador,
# sem timer, sem overhead, sem precisar subir container nenhum.
#
# Para ligar, suba o stack e preencha:
#   docker compose -f infra/docker-compose.observability.yml up -d
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Grafana em http://localhost:3300 (admin/admin). Ver docs/OPERATIONS.md §Observabilidade.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Nome do serviço nos três sinais. É o `service_name` no Loki e o `job` no Prometheus.
OTEL_SERVICE_NAME=fatia-api

# ============================================================
# Insights B2B (#160)
# ============================================================
#
# Ids de grupo com o add-on pago de insights de comportamento, separados por
# vírgula. Vazio = ninguém tem. Habilitação manual enquanto a cobrança (#158)
# não existe — e é DÍVIDA DECLARADA: esta lista não sabe que um cliente
# cancelou. Some quando `GroupSubscription.insightsAddOn` existir.
INSIGHTS_ADDON_GROUP_IDS=

# ============================================================
# Cobrança por aluno ativo (#158) — Asaas
# ============================================================
#
# Vazio = cobrança desligada, que é como a instância pública roda hoje. Sem
# estas três o motor de cobrança não nasce e NADA muda para o usuário: o app é
# grátis para o aluno, e ele nunca vê cobrança em caminho nenhum.
#
# ⚠️ A CHAVE DE PRODUÇÃO NÃO VIVE NO REPOSITÓRIO NEM NO CI.
# O sandbox tem chave própria, gratuita, tirada em https://sandbox.asaas.com.
# Nenhum teste precisa de chave: `AsaasProvider.fromEnv` **recusa** rodar em
# NODE_ENV=test, e as suítes usam o `FakeBillingProvider`.
#   Sandbox:   ASAAS_BASE_URL=https://api-sandbox.asaas.com
#   Produção:  ASAAS_BASE_URL=https://api.asaas.com
ASAAS_BASE_URL=
ASAAS_API_KEY=

# Segredo que o Asaas devolve no header `asaas-access-token` de todo webhook.
# É a única autenticação de uma rota que é pública por natureza — sem ele,
# qualquer um marca fatura como paga.
#   openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# ============================================================
# Web
#
# ⚠️ Tudo que começa com NEXT_PUBLIC_ vai INLINADO no bundle JavaScript servido
# ao navegador — é texto legível por qualquer visitante, e o valor fica gravado
# na imagem Docker no momento do build (infra/web.Dockerfile). NENHUM segredo
# entra numa variável com esse prefixo: nem chave de API, nem secret do Logto,
# nem DSN de banco. Segredo do PWA fica em variável SEM o prefixo, lida só no
# servidor (Route Handler / Server Component).
#
# Mesma regra do EXPO_PUBLIC_ em apps/mobile/.env.example.
# ============================================================
WEB_PORT=3030
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================================
# Agente de IA (apps/agent, ADR 015) — inferência hospedada pela Fatia
#
# VAZIO = o agente sobe, /health responde 200 e qualquer capacidade responde
# AI_PROVIDER_NOT_CONFIGURED. O produto continua inteiro: o registro manual
# nunca depende de IA. Não há default de provedor de propósito.
#
# ⚠️ Isto NÃO tem nada a ver com o Claude do usuário pelo /mcp, que continua
# custando zero para o projeto (ADR 018).
# ============================================================

# Endpoint OpenAI-compatível. Em desenvolvimento, LM Studio local:
#   AI_BASE_URL=http://localhost:1234/v1
# Dentro do container do agente, o host é host.docker.internal:
#   AI_BASE_URL=http://host.docker.internal:1234/v1
AI_BASE_URL=

# O LM Studio dispensa credencial. Um gateway não — com AI_BASE_URL remota e
# esta variável vazia, o agente recusa a subir a capacidade em vez de tomar 401
# só no primeiro deploy.
AI_API_KEY=

# Um modelo por capacidade, de propósito: o gateway roteia visão e texto para
# modelos diferentes, e amarrar tudo a um nome só é o acoplamento que a
# abstração existe para evitar. Trocar de modelo é editar aqui e reiniciar.
AI_MODEL_TEXT=
AI_MODEL_VISION=
AI_MODEL_EMBEDDING=

# Visão em CPU local leva dezenas de segundos; um timeout curto vira "o modelo
# não responde" quando na verdade o cliente desistiu.
AI_TIMEOUT_S=120

# --- Custo e cota da IA hospedada (issue #135) -------------------------------
# Quem mede e aplica a cota é a API, antes de chamar o agente: o agente não tem
# credencial de banco (ADR 015) e é disparado com o token do próprio usuário.
#
# Tabela de preço por modelo, em MICRO-UNIDADES da moeda por MILHÃO de unidades
# (token, ou segundo de áudio). A escala é fácil de errar por uma ordem de
# grandeza: US$ 3,00 por milhão de tokens se escreve 3000000, porque US$ 3,00
# são 3.000.000 de micro-dólares. Escrever 3 significaria US$ 0,000003 por
# milhão, e o sintoma seria um mês de custo zero seguido de uma fatura real.
#
# Modelo local vai com preço 0 declarado — isso é correto e vira custo 0 com o
# preço CONHECIDO. Modelo AUSENTE da tabela é outra coisa: entra como preço
# desconhecido, para o alerta de anomalia enxergar. Vazio = sem IA hospedada.
# Exemplo: {"gateway/modelo":{"in":3000000,"out":15000000},"local/gemma":{"in":0,"out":0}}
AI_PRICE_TABLE=

# Tetos diários, em micro-unidades, na janela de dia corrido UTC. Estourar
# devolve 429 nomeado e o usuário cai no registro manual — a cota degrada, nunca
# cobra do aluno (#158, cobrança por cabeça).
# 0 = sem cota, que é o certo para instância local: não há custo a conter.
AI_QUOTA_DAILY_MICROS=0
# O teto por usuário não protege contra mil usuários novos no mesmo dia.
AI_QUOTA_GLOBAL_DAILY_MICROS=0
# Quantas chamadas de custo DESCONHECIDO a janela tolera antes de a cota fechar.
# Modelo fora da AI_PRICE_TABLE estima custo 0; se a soma fica em 0, os dois
# tetos acima liberam para sempre — a cota se desligaria sozinha exatamente
# quando a medição se perdeu. Aqui 0 NÃO desliga a guarda: significa "nenhuma
# tolerância". Ela só vale quando algum dos dois tetos acima está ligado, então
# instância local com AI_PRICE_TABLE vazia não é afetada.
AI_QUOTA_UNPRICED_DAILY_CALLS=20

# Porta publicada pelo container do agente (perfil `agent` do compose).
AGENT_PORT=8100

# Como o apps/api alcança o agente. VAZIO = o registro de refeição por foto
# (#139) e o chat com IA (#249) **somem da interface**, e o app continua inteiro
# pelo caminho manual. Não há default de propósito: um endereço adivinhado
# ligaria as funcionalidades numa instância que não pediu por elas.
#   Rodando pelo compose:  AGENT_BASE_URL=http://agent:8100
#   Agente pelo uv, API na máquina: AGENT_BASE_URL=http://localhost:8100
#
# ⚠️ ANTES DE PREENCHER ISTO EM PRODUÇÃO, ATUALIZE A PÁGINA DE PRIVACIDADE.
# A `/privacy` afirma hoje, em duas passagens, que a IA hospedada "ainda não
# está disponível para nenhum usuário da instância pública". Essa frase é
# verdadeira **porque esta variável está vazia lá**, e não porque o código
# não exista — ele existe e está testado desde a #139. Preencher aqui torna
# a afirmação falsa no mesmo deploy, sem que nada quebre ou avise.
# Ver `apps/web/src/app/(public)/privacy/page.tsx`.
AGENT_BASE_URL=

# Segredo compartilhado entre apps/api e apps/agent, mandado no header
# X-Fatia-Agent-Key. Obrigatório quando AI_BASE_URL não é local: uma rota de
# inferência anônima é um proxy aberto para o gateway pago (ADR 018). Com o
# LM Studio local, inferência não custa nada e o agente dispensa o segredo.
#   openssl rand -hex 32
AGENT_API_KEY=

# Endpoint do /mcp que o AGENTE usa para alcançar dado do usuário (ADR 021). É o
# único destino para onde o Bearer de quem está conversando sai do agente. De
# dentro do compose, o apps/api é `api`:
#   MCP_BASE_URL=http://api:3000/mcp
# Nome de serviço do compose (`api`, sem ponto) e localhost passam em http: os
# dois só resolvem dentro de uma rede que alguém montou. Endereço com ponto
# (api.exemplo.com) exige https — sem TLS o token de acesso de cada usuário
# trafega em texto puro, e o agente recusa antes da primeira chamada.
# Vazio = a rota /chat do agente degrada com MCP_NOT_CONFIGURED.
MCP_BASE_URL=

# Teto do apps/api para a chamada de reconhecimento. Visão em CPU passa de 100 s
# com foto pequena; um valor curto vira "a IA falhou" com a inferência paga do
# mesmo jeito. O proxy reverso em produção precisa acomodar este número.
AGENT_TIMEOUT_MS=180000

# ============================================================
# Admin inicial (apenas referência — usuário criado no console do Logto)
# ============================================================
ADMIN_EMAIL=admin@fatia.local
ADMIN_NAME=Admin
