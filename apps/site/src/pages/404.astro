---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada — Fatia" description="O endereço não existe ou foi movido.">
  <section class="mx-auto max-w-5xl px-6 py-32">
    <h1 class="font-display text-4xl font-extrabold tracking-tight">Página não encontrada</h1>
    <p class="mt-4 text-muted-foreground">O endereço não existe ou foi movido.</p>
    <a href="/" class="mt-8 inline-block font-semibold text-primary underline underline-offset-4">
      Voltar para a home
    </a>
  </section>
</Base>
