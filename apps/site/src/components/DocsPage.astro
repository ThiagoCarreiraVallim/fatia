---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { COPY, SECTIONS, type Lang } from '../lib/docs-content';

/**
 * Corpo compartilhado de /docs e /docs/en (issue #113).
 *
 * As duas rotas renderizam este mesmo componente com `lang` diferente, então a
 * estrutura não pode divergir entre os idiomas — só o texto muda.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const otherHref = lang === 'pt' ? '/docs/en/' : '/docs/';
const canonical = lang === 'pt' ? '/docs/' : '/docs/en/';
---

<Base
  title={`${COPY.title[lang]} — Fatia`}
  description={COPY.metaDescription[lang]}
  canonical={canonical}
>
  <section class="mx-auto max-w-5xl px-6 pb-10 pt-16 sm:pt-24">
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="font-display text-sm font-bold uppercase tracking-widest text-primary">
          {lang === 'pt' ? 'Guia de uso' : 'Usage guide'}
        </p>
        <h1
          class="font-display mt-4 max-w-3xl text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-5xl"
        >
          {COPY.title[lang]}
        </h1>
      </div>
      <a
        href={otherHref}
        rel="alternate"
        hreflang={lang === 'pt' ? 'en' : 'pt-BR'}
        class="mt-2 shrink-0 rounded-lg border border-border px-3 py-1.5 text-sm font-semibold transition-colors hover:bg-muted"
      >
        {COPY.otherLang[lang]}
      </a>
    </div>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
      {COPY.lede[lang]}
    </p>
  </section>

  <!-- Seções por assunto -->
  <section class="mx-auto max-w-5xl space-y-5 px-6 pb-4">
    {
      SECTIONS.map(({ icon, title, intro, examples }) => (
        <article class="rounded-2xl border border-border/60 bg-card/40 p-6 sm:p-8">
          <div class="flex items-center gap-2.5">
            <Icon name={icon} class="h-[18px] w-[18px] text-primary" aria-hidden="true" />
            <h2 class="font-display text-xl font-extrabold tracking-tight">{title[lang]}</h2>
          </div>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">
            {intro[lang]}
          </p>
          <ul class="mt-5 space-y-2.5">
            {examples[lang].map((example) => (
              <li class="rounded-xl border border-border/40 bg-background/40 px-4 py-3 text-sm leading-relaxed">
                “{example}”
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <!-- Dicas -->
  <section class="mx-auto max-w-5xl px-6 py-8">
    <h2 class="font-display text-2xl font-extrabold tracking-tight">{COPY.tipsTitle[lang]}</h2>
    <ul class="mt-5 space-y-3">
      {
        COPY.tips[lang].map((tip) => (
          <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
            <Icon
              name="lucide:check"
              class="mt-0.5 h-4 w-4 shrink-0 text-primary"
              aria-hidden="true"
            />
            <span>{tip}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Privacidade + CTA -->
  <section class="mx-auto max-w-5xl px-6 pb-20 pt-4">
    <div class="rounded-2xl border border-border/60 p-6 sm:p-8">
      <div class="flex items-center gap-2.5">
        <Icon name="lucide:lock" class="h-[18px] w-[18px] text-primary" aria-hidden="true" />
        <h2 class="font-display text-lg font-extrabold tracking-tight">
          {COPY.privacyTitle[lang]}
        </h2>
      </div>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        {COPY.privacyBody[lang]}
      </p>
      <p class="mt-4 text-sm">
        <a href={site.privacyUrl} class="text-foreground underline underline-offset-4">
          {lang === 'pt' ? 'Política de Privacidade' : 'Privacy Policy'}
        </a>
        <span class="text-muted-foreground"> · </span>
        <a href={site.termsUrl} class="text-foreground underline underline-offset-4">
          {lang === 'pt' ? 'Termos de Serviço' : 'Terms of Service'}
        </a>
      </p>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <span class="text-sm text-muted-foreground">{COPY.notConnected[lang]}</span>
      <a
        href="/claude-connect/"
        class="group inline-flex items-center gap-2 rounded-xl border border-border px-5 py-3 text-sm font-semibold transition-colors hover:bg-muted"
      >
        {COPY.notConnectedCta[lang]}
        <Icon
          name="lucide:arrow-right"
          class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
    </div>
  </section>
</Base>
