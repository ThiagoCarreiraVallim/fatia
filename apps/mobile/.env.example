# Configuração do app nativo.
#
# Copie para apps/mobile/.env. Tudo aqui vai inlinado no bundle e é legível por
# quem baixar o app — NENHUM segredo entra neste arquivo.
#
# Os valores abaixo apontam para a instância de produção, que é o caminho mais
# curto para testar o app sem subir a stack local. Para rodar contra o backend
# local veja a seção "Rodando contra o backend local" do README.

EXPO_PUBLIC_API_URL=https://api.fat.ia.br
EXPO_PUBLIC_LOGTO_ENDPOINT=https://auth.fat.ia.br
EXPO_PUBLIC_LOGTO_AUDIENCE=https://api.fat.ia.br

# App ID da Application do tipo "Native" no Logto (não é a mesma do PWA, que é
# "Traditional Web"). Criar em Console do Logto > Applications > Create.
# Redirect URI a cadastrar lá: fatia://auth/callback
EXPO_PUBLIC_LOGTO_APP_ID=

# Chaves PÚBLICAS do SDK da RevenueCat (appl_... e goog_...), em Project
# settings > API keys. São públicas por desenho. Vazio = a tela "Meu plano"
# mostra o plano, mas avisa que a assinatura não está disponível neste build
# (é o caso do Expo Go, que não tem o módulo nativo).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Domínio do link universal do convite de comunidade (https://<host>/c/<token>),
# o mesmo do PWA (ex.: app.fat.ia.br). Lido no build (app.config.ts), sem o
# prefixo EXPO_PUBLIC_. Vazio = o app só abre fatia://c/<token>. Exige que a web
# sirva /.well-known/* com APPLE_TEAM_ID e ANDROID_CERT_SHA256.
APP_LINKS_HOST=
