{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.fat.ia.br",
        "EXPO_PUBLIC_LOGTO_ENDPOINT": "https://auth.fat.ia.br",
        "EXPO_PUBLIC_LOGTO_AUDIENCE": "https://api.fat.ia.br"
      },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.fat.ia.br",
        "EXPO_PUBLIC_LOGTO_ENDPOINT": "https://auth.fat.ia.br",
        "EXPO_PUBLIC_LOGTO_AUDIENCE": "https://api.fat.ia.br"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.fat.ia.br",
        "EXPO_PUBLIC_LOGTO_ENDPOINT": "https://auth.fat.ia.br",
        "EXPO_PUBLIC_LOGTO_AUDIENCE": "https://api.fat.ia.br"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {}
  }
}
