# Env local do agente. Copie para `apps/agent/.env` — as mesmas variáveis
# existem no `.env` da raiz, usadas pelo compose. Rodando pelo `uv`, é este
# arquivo que vale.
#
# VAZIO = degradação explícita: o serviço sobe, /health responde 200 e as
# capacidades respondem AI_PROVIDER_NOT_CONFIGURED. Ver README.md.

# LM Studio local em desenvolvimento; Cloudflare AI Gateway em produção.
AI_BASE_URL=http://localhost:1234/v1

# O LM Studio dispensa credencial. Fora de localhost, ela é obrigatória.
AI_API_KEY=

# Um modelo por capacidade. Os nomes abaixo são os que o LM Studio local serve.
#
# ⚠️ Contra endpoint REMOTO, o modelo precisa estar em ALLOWED_MODELS
# (src/fatia_agent/allowed_models.py) — trocar o modelo troca o subprocessador
# que a /privacy nomeia, e a lista faz essa troca passar por um PR (ADR 020).
# Contra endpoint local, como este, não há terceiro e a lista não se aplica.
AI_MODEL_TEXT=ornith-1.0-9b
AI_MODEL_VISION=google/gemma-4-12b-qat
AI_MODEL_EMBEDDING=text-embedding-nomic-embed-text-v1.5

AI_TIMEOUT_S=120
AI_MAX_RETRIES=2
