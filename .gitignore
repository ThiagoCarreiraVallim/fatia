# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.turbo/
# Tipos gerados pelo Astro (apps/site)
.astro/

# Artefatos gerados pelo Next/tsc a cada build — sujam o working tree sem
# agregar nada ao histórico (mesma lista do create-next-app).
*.tsbuildinfo
next-env.d.ts

# Env
.env
.env.local
.env.*.local
.env.production
# Credenciais do backup (passphrase + chaves S3), preenchidas no host.
.env.backup
!.env.example
!.env.production.example
!.env.backup.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Prisma
packages/db/node_modules/.prisma/

# Expo (apps/mobile)
.expo/
apps/mobile/expo-env.d.ts
# Projetos nativos gerados por `expo prebuild` — o managed workflow os recria a
# partir do app.config.ts, versioná-los faz o config divergir do que é buildado.
apps/mobile/ios/
apps/mobile/android/

# Fotos do conjunto de avaliação do reconhecimento (#138). Os **rótulos** são
# versionados (apps/agent/eval/manifest.jsonl) e as imagens não: foto de refeição
# de gente real é dado de saúde, a mesma categoria que docs/DATA_RETENTION.md
# promete não guardar, e um diretório de pratos num repositório público não tem
# desfazer. O sha256 no manifesto é o que amarra o número publicado a estas fotos.
apps/agent/eval/images/

# Python (apps/agent, ADR 015)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
coverage/

# Testes
.nyc_output/

# Worktrees dos subagentes do Claude Code — cópias efêmeras do próprio repo.
.claude/worktrees/
