# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.turbo/
# Tipos gerados pelo Astro (apps/site)
.astro/

# Artefatos gerados pelo Next/tsc a cada build — sujam o working tree sem
