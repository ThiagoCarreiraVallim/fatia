*.tsbuildinfo
next-env.d.ts

# Env
.env
.env.local
.env.*.local
.env.production
# Credenciais do backup (passphrase + chaves S3), preenchidas no host.
.env.backup
!.env.example
!.env.production.example
!.env.backup.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Prisma
packages/db/node_modules/.prisma/

# Expo (apps/mobile)
.expo/
apps/mobile/expo-env.d.ts
# Projetos nativos gerados por `expo prebuild` — o managed workflow os recria a
# partir do app.config.ts, versioná-los faz o config divergir do que é buildado.
apps/mobile/ios/
apps/mobile/android/

# Coverage
coverage/

# Testes
.nyc_output/

# Worktrees dos subagentes do Claude Code — cópias efêmeras do próprio repo.
.claude/worktrees/
