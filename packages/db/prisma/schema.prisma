// Fatia — Prisma schema
// Documentação: ../../../docs/ARCHITECTURE.md
// Decisões: ../../../docs/ADR/

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id       String @id @default(uuid())
  // Sub claim do JWT do Logto. Identidade externa estável (ver ADR 008).
  logtoSub String @unique
  email    String @unique
  name     String
  role     Role   @default(USER)
  timezone String @default("America/Sao_Paulo")
  heightCm Float?

  // Perfil do onboarding: só alimentam a sugestão de metas (gasto pela
  // Mifflin-St Jeor). Nenhum aparece para terceiros nem entra em comparação.
  sex              BiologicalSex?
  birthDate        DateTime?      @db.Date
  activityLevel    ActivityLevel?
  objective        BodyObjective?
  // Nulo = ainda não passou pelo assistente de primeira vez (nem o pulou, nem
  // definiu metas por outro caminho). O app redireciona enquanto for nulo.
  onboardedAt      DateTime?
  /// Etapa do onboarding em que a pessoa está (#371), para voltar na mesma tela
  /// ao reabrir o app ou a web. Nulo = não começou ou já terminou. Continua
  /// preenchida depois do `onboardedAt` enquanto faltam as etapas puláveis
  /// (lembretes, notificações, IA). Chaves em `ONBOARDING_STEPS` da API.
  onboardingStep   String?
  /// Rascunho do que ainda não tem coluna própria (peso digitado, metas
  /// escolhidas, origem da meta). Dado da pessoa: sai no export e some no fim.
  onboardingDraft  Json?
  /// Desde quando o cartão "Primeiros passos" aparece no Hoje: o fim do
  /// onboarding. Quem entrou antes do #371 não vê o cartão.
  firstStepsSince  DateTime?
  /// Quando os três primeiros passos ficaram prontos: o cartão some no dia
  /// seguinte, no fuso da pessoa.
  firstStepsDoneAt DateTime?

  // Cliente no Asaas (assinatura PRO pela web, ADR 024). Só o id do provedor:
  // CPF e cartão ficam no Asaas, nunca aqui.
  asaasCustomerId String? @unique

  // Perfil nas comunidades (Você › Editar perfil, #387). O apelido vale para
  // mural, comentários e ranking quando a comunidade não tem um próprio
  // (`GroupMembership.displayName` continua vencendo). A bio tem até 140
  // caracteres, conferidos na API.
  nickname         String?
  bio              String?
  /// Foto de perfil (mídia `user_avatar`, ADR 028): EXIF removido no servidor.
  avatarFileId     String?          @unique
  /// Quem vê a foto. Fora das comunidades da pessoa, ninguém.
  avatarVisibility AvatarVisibility @default(COMMUNITIES)
  /// "Guardar fotos das refeições" (ADR 038). Nulo = ainda não respondeu, e a
  /// foto é usada e descartada como antes. Só `true` guarda (#374).
  keepMealPhotos   Boolean?
  /// WhatsApp para a equipe chamar (o Fatia não tem chat entre pessoas). Só
  /// aparece para a equipe com `whatsappOptIn` ligado.
  whatsapp         String?
  whatsappOptIn    Boolean          @default(false)
  /// Unidades de exibição (Você › Unidades). Banco e API continuam métricos: a
  /// conversão é só no cliente, e a equipe vê na unidade dela.
  loadUnit         LoadUnit         @default(KG)
  distanceUnit     DistanceUnit     @default(KM)

  /// Silêncio noturno (Você › Lembretes, #389): nenhum lembrete nem aviso
  /// toca entre `quietFrom` e `quietTo`, minutos do dia no `timezone` da
  /// pessoa. A janela pode virar a meia-noite (22:00–07:00 é o padrão).
  quietHoursEnabled Boolean @default(true)
  quietFrom         Int     @default(1320)
  quietTo           Int     @default(420)

  /// Busca na web no chat (#384): o ícone do topo liga e desliga. Ligada só vale depois do
  /// aceite da primeira busca (`AiConsent` WEB_SEARCH); desligada, a IA nem oferece a busca.
  webSearchEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals                  UserGoals?
  authoredChallenges     GroupChallenge[]   @relation("ChallengeAuthor")
  personalGoals          Goal[]
  meals                  Meal[]
  workoutPlans           WorkoutPlan[]
  workoutSessions        WorkoutSession[]
  workoutCheckins        WorkoutCheckin[]
  weightLogs             WeightLog[]
  stepLogs               StepLog[]
  waterLogs              WaterLog[]
  customFoods            Food[]             @relation("UserCustomFoods")
  favoriteFoods          FavoriteFood[]
  foodPortions           FoodPortion[]
  mealTemplates          MealTemplate[]
  customExercises        Exercise[]         @relation("UserCustomExercises")
  favoriteExercises      FavoriteExercise[]
  nutrientTargets        NutrientTarget[]
  achievements           UserAchievement[]
  trainingBlocks         TrainingBlock[]
  /// Planos de treino que a equipe mandou para a pessoa (#379). É dado dela.
  planOffers             PlanOffer[]        @relation("PlanOfferSubject")
  /// Ofertas que a pessoa, como profissional, mandou para alunos (#379).
  planOffersAuthored     PlanOffer[]        @relation("PlanOfferAuthor")
  /// A agenda de treinos (#379): as sessões dos planos de calendário.
  plannedSessions        PlannedSession[]
  /// Plano alimentar que a equipe mandou para a pessoa (#376). É dado dela.
  nutritionPlans         NutritionPlan[]    @relation("NutritionPlanSubject")
  /// Planos que a pessoa, como profissional, escreveu para alunos (#376, #407).
  nutritionPlansAuthored NutritionPlan[]    @relation("NutritionPlanAuthor")

  conversations  Conversation[]
  memories       UserMemory[]
  aiConsents     AiConsent[]
  /// O que a IA do chat faz sozinha, por categoria (ADR 039, #385). Sem linha = Perguntar antes.
  aiWriteModes   AiWriteModeSetting[]
  /// As gravações automáticas da IA, com o retrato para o Desfazer (ADR 039, #385).
  aiAutoWrites   AiAutoWrite[]
  aiUsage        AiUsage[]
  subscriptions  UserSubscription[]
  invitesCreated GroupInvite[]        @relation("GroupInviteCreator")
  mediaFiles     MediaFile[]          @relation("MediaUploader")
  planTemplates  GroupPlanTemplate[]  @relation("PlanTemplateAuthor")
  tipsAuthored   GroupTip[]           @relation("TipAuthor")
  guidesAuthored GroupExerciseGuide[] @relation("GuideAuthor")

  // Avisos no celular (ADR 033).
  devices                 UserDevice[]
  notificationPreferences NotificationPreference[]
  pendingNotices          PendingNotice[]
  webPushSubscriptions    WebPushSubscription[]
  // Central de avisos do sino do Hoje (#373).
  inboxNotices            InboxNotice[]
  // Lembretes pessoais (#389). A equipe não vê.
  reminders               Reminder[]

  // Você (#387): foto, novidades lidas, tutoriais vistos, ideias enviadas e os
  // links de exportação.
  avatarFile    MediaFile?         @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  newsReads     UserNewsRead[]
  tutorialsSeen UserTutorialSeen[]
  feedbackIdeas FeedbackIdea[]
  dataExports   DataExport[]

  // B2B (ADR 014). Nenhuma destas relações dá acesso a dado de saúde por si só —
  // quem autoriza leitura é exclusivamente uma linha de `ProfessionalLink`.
  ownedGroups         Group[]                 @relation("GroupOwner")
  memberships         GroupMembership[]
  linksAsSubject      ProfessionalLink[]      @relation("LinkSubject")
  linksAsProfessional ProfessionalLink[]      @relation("LinkProfessional")
  accessLogs          ProfessionalAccessLog[] @relation("AccessLogSubject")

  @@index([logtoSub])
}

enum BiologicalSex {
  FEMALE
  MALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum BodyObjective {
  LOSE
  MAINTAIN
  GAIN
}

enum Role {
  USER
  ADMIN
}

/// Quem vê a foto de perfil (prancha Al-V9). Fora das comunidades da pessoa,
/// ninguém vê, em nenhum dos dois.
enum AvatarVisibility {
  /// Membros e equipe das comunidades em que a pessoa está.
  COMMUNITIES
  /// Só a equipe; os outros membros veem as iniciais.
  TEAM_ONLY
}

enum LoadUnit {
  KG
  LB
}

enum DistanceUnit {
  KM
  M
  MI
}

/// Novidade que a pessoa já leu. O conteúdo das novidades vive em código
/// (`news-catalog.ts`), como as conquistas: entra junto do deploy da função que
/// ele anuncia, sem migration por entrada.
model UserNewsRead {
  userId String
  newsId String
  readAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, newsId])
}

/// Tutorial da ajuda que a pessoa já abriu (selo "assistido"). O conteúdo vive
/// em `@fatia/api-client` (`tutorials.ts`), para o texto estar no aparelho sem
/// internet.
model UserTutorialSeen {
  userId     String
  tutorialId String
  seenAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tutorialId])
}

/// "Sugerir uma ideia" (Você › Novidades). Texto da pessoa, lido pela equipe do
/// Fatia; sai no export e com a conta.
model FeedbackIdea {
  id        String   @id @default(uuid())
  userId    String
  body      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Link de exportação dos dados (LGPD art. 18, V), válido por 24 h. Só o hash do
/// token fica no banco, como no convite; o arquivo é montado na hora do
/// download, então nenhuma cópia dos dados fica parada no servidor.
model DataExport {
  id           String    @id @default(uuid())
  userId       String
  /// sha256 do token, em hex.
  tokenHash    String    @unique
  expiresAt    DateTime
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// OAuth facade pro MCP: Logto não expõe DCR público, então a API age
// como AS público (DCR + authorize/token) e federa pro Logto internamente.
model McpOAuthClient {
  id           String    @id @default(uuid())
  clientId     String    @unique
  clientName   String?
  redirectUris String[]
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  authorizations McpOAuthAuthorization[]
}

model McpOAuthAuthorization {
  id                  String    @id @default(uuid())
  // State que mandamos pro Logto — usado no /oauth/callback
  state               String    @unique
  // Code que devolvemos pro cliente MCP (Claude) — preenchido no callback
  code                String?   @unique
  clientId            String
  redirectUri         String
  // State original do cliente MCP — relayed no redirect final
  clientState         String?
  // PKCE enviado pelo cliente MCP — verificado no /oauth/token
  clientCodeChallenge String
  // PKCE que nós usamos com o Logto — usado no token exchange downstream
  logtoCodeVerifier   String
  // Code recebido do Logto no /oauth/callback
  logtoCode           String?
  // resource indicator (RFC 8707), se enviado
  resource            String?
  scope               String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  client McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model UserGoals {
  userId             String   @id
  kcalMin            Int
  kcalMax            Int
  proteinMinG        Int
  proteinMaxG        Int
  carbsMinG          Int
  carbsMaxG          Int
  fatMinG            Int
  fatMaxG            Int
  weeklyWorkouts     Int      @default(3)
  dailyStepsTarget   Int      @default(8000)
  dailyWaterTargetMl Int      @default(2500)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// NUTRITION
// ============================================================

model FoodGroup {
  id   Int    @id @default(autoincrement())
  name String @unique // "cereais", "leguminosas", "carnes", "frutas", etc

  foods             Food[]
  mealItems         MealItem[]
  mealTemplateItems MealTemplateItem[]
}

model Food {
  id              Int        @id @default(autoincrement())
  name            String
  source          FoodSource
  groupId         Int?
  // Para CUSTOM foods: dono. Null para TACO/USDA (catálogo público).
  createdByUserId String?
  kcalPer100g     Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  // Micronutrientes por 100g (catálogo), mapa flexível: { "sodium_mg": 1.2, "fiber_g": 2.7 }.
  // Derivado por regra de 3 para MealItem.nutrients ao logar (ADR 009).
  nutrients       Json?
  // Nome reduzido à forma comparável (minúsculo, sem acento, sem pontuação).
  // Existe porque `contains` no `name` não acha "feijao" para "Feijão" — e no
  // teclado do celular ninguém acentua. Mantido por `FoodService`; ver
  // `apps/api/src/common/search-text.ts`.
  searchName      String     @default("")
  /// Código de barras (EAN/UPC, só dígitos) que a pessoa ligou ao alimento
  /// próprio (#375). É escolha dela, não cache do Open Food Facts (ADR 017):
  /// só `CUSTOM` tem, e é único por dono, para a leitura achar um alimento só.
  barcode         String?
  createdAt       DateTime   @default(now())

  group           FoodGroup?                @relation(fields: [groupId], references: [id])
  createdBy       User?                     @relation("UserCustomFoods", fields: [createdByUserId], references: [id], onDelete: Cascade)
  mealItems       MealItem[]
  favoritedBy     FavoriteFood[]
  portions        FoodPortion[]
  templateItems   MealTemplateItem[]
  planItems       NutritionPlanItem[]
  planEquivalents NutritionPlanEquivalent[]

  // Unicidade por (nome, source) só para públicos. Customs podem repetir nomes
  // entre usuários — unicidade real é (nome, source, createdByUserId).
  @@unique([name, source, createdByUserId])
  @@unique([createdByUserId, barcode])
  @@index([searchName])
  @@index([name])
  @@index([source])
  @@index([createdByUserId])
}

// Atalho da busca de alimento: o que a pessoa marca para achar em um toque.
// Os "recentes" não têm tabela — saem do histórico de `MealItem`.
model FavoriteFood {
  id        String   @id @default(uuid())
  userId    String
  foodId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
  @@index([userId, createdAt])
}

// Medida caseira: "colher de sopa = 25 g". Atalho que vira gramas no registro —
// `MealItem.grams` continua sendo a verdade. Sem dono = catálogo curado
// (`prisma/data/medidas-caseiras.json`); com dono = medida da própria pessoa.
model FoodPortion {
  id              String   @id @default(uuid())
  foodId          Int
  label           String
  grams           Float
  createdByUserId String?
  createdAt       DateTime @default(now())

  food      Food  @relation(fields: [foodId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([foodId, label, createdByUserId])
  @@index([foodId])
  @@index([createdByUserId])
}

enum FoodSource {
  TACO
  USDA
  CUSTOM
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Meal {
  id          String   @id @default(uuid())
  userId      String
  mealType    MealType
  eatenAt     DateTime
  notes       String?
  /// Foto do prato (ADR 038, #374): mídia pessoal `meal_photo`, uma por
  /// refeição. Só existe quando a pessoa escolheu guardar as fotos e a foto
  /// virou esta refeição. Apagar a foto, a refeição ou a conta apaga o arquivo.
  photoFileId String?  @unique
  createdAt   DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     MealItem[]
  photoFile MediaFile?         @relation("MealPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  /// "Comi isso" no plano alimentar (#376): apagar a refeição desfaz o "feito".
  planLogs  NutritionPlanLog[]

  @@index([userId, eatenAt])
}

/// De onde veio o item (#374): é o que pinta o selo "IA" na refeição.
enum MealItemSource {
  /// Digitado ou escolhido na busca pela pessoa.
  MANUAL
  /// Estimado pela IA: foto do prato, ditado, chat ou conector MCP.
  AI
  /// Veio do plano alimentar ("Comi isso", #376).
  PLAN
  /// Código de barras ou foto do rótulo.
  BARCODE
}

model MealItem {
  id              String         @id @default(uuid())
  mealId          String
  /// A ordem de inserção, e só isso: os itens de uma refeição saem por ela (`ITENS_EM_ORDEM`).
  /// Sem ela, a ordem era a física da tabela, e um UPDATE que não cabe na página muda de lugar.
  /// O `PrismaService` a omite de toda resposta.
  seq             Int            @default(autoincrement())
  foodId          Int? // null = item livre estimado pelo Claude
  groupId         Int? // copiado do food, ou inferido pelo Claude
  foodName        String // snapshot — sempre preenchido
  grams           Float
  kcal            Float
  proteinG        Float
  carbsG          Float
  fatG            Float
  // Micronutrientes opcionais (snapshot), mapa flexível: { "sodium_mg": 412, "sugar_g": 9 }.
  // Json em vez de colunas fixas: nutrientes são open-ended e a TACO não cobre todos
  // (ADR 009). Ausente = não rastreado para aquele item.
  nutrients       Json?
  // Retrato de como a quantidade foi digitada ("2 × colher de sopa"). Só exibição
  // e sugestão da próxima vez; a conta usa `grams`. Nulos quando veio em gramas.
  portionLabel    String?
  portionQuantity Float?
  source          MealItemSource @default(MANUAL)

  meal  Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food  Food?      @relation(fields: [foodId], references: [id])
  group FoodGroup? @relation(fields: [groupId], references: [id])

  @@index([mealId])
}

// Refeição salva ("meu café de sempre"): registrada de novo em um toque. Guarda o
// retrato dos itens como foram registrados, sem recalcular: o que a pessoa comeu
// continua igual mesmo se o alimento personalizado for apagado depois.
model MealTemplate {
  id             String    @id @default(uuid())
  userId         String
  name           String
  // Tipo sugerido ao registrar; null = quem registra escolhe.
  mealType       MealType?
  /// Plano pronto da comunidade de onde esta refeição veio (Fase 7). Só
  /// proveniência: a cópia é da pessoa e não acompanha o modelo.
  fromTemplateId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        MealTemplateItem[]
  fromTemplate GroupPlanTemplate?    @relation("MealFromTemplate", fields: [fromTemplateId], references: [id], onDelete: SetNull)
  /// Opção do plano alimentar que gerou esta refeição salva ao aceitar (#376).
  planOptions  NutritionPlanOption[]

  @@unique([userId, name])
  @@index([userId])
}

model MealTemplateItem {
  id              String  @id @default(uuid())
  templateId      String
  position        Int
  foodId          Int?
  groupId         Int?
  foodName        String
  grams           Float
  kcal            Float
  proteinG        Float
  carbsG          Float
  fatG            Float
  nutrients       Json?
  portionLabel    String?
  portionQuantity Float?

  template MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  food     Food?        @relation(fields: [foodId], references: [id], onDelete: SetNull)
  group    FoodGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([templateId])
}

// ============================================================
// PLANO ALIMENTAR DO PROFISSIONAL (#376, ADR 045)
// ============================================================

/// SENT: chegou e espera o aceite. ACCEPTED: o plano em uso (um por pessoa).
/// SUPERSEDED: veio uma versão nova, ou outro plano foi aceito. Recusar não
/// muda nada: o plano fica SENT até ser aceito ou substituído.
enum NutritionPlanStatus {
  SENT
  ACCEPTED
  SUPERSEDED
}

/// Plano alimentar escrito por um profissional para um aluno (ADR 045: autoral,
/// sem sugestão da IA). A linha é do ALUNO (`userId`): entra no export dele e
/// some com a conta dele. O autor apagar a conta não leva o plano, só o nome.
///
/// As metas vêm como faixa, como `UserGoals`: aceitar com `applyGoals` copia
/// as oito colunas para as metas do dia.
model NutritionPlan {
  id           String              @id @default(uuid())
  userId       String
  authorId     String?
  /// Comunidade em que o plano foi enviado: diz quem da equipe vê as trocas.
  groupId      String?
  /// 1, 2, 3… por aluno e autor. Aparece como "· v2" no cabeçalho.
  version      Int
  status       NutritionPlanStatus @default(SENT)
  kcalMin      Int
  kcalMax      Int
  proteinMinG  Int
  proteinMaxG  Int
  carbsMinG    Int
  carbsMaxG    Int
  fatMinG      Int
  fatMaxG      Int
  /// Aceitar aplica as faixas acima às metas do dia.
  applyGoals   Boolean             @default(true)
  /// Recado do profissional, texto puro.
  note         String?
  sentAt       DateTime            @default(now())
  acceptedAt   DateTime?
  supersededAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user   User                @relation("NutritionPlanSubject", fields: [userId], references: [id], onDelete: Cascade)
  author User?               @relation("NutritionPlanAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  group  Group?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  meals  NutritionPlanMeal[]
  swaps  NutritionSwap[]

  @@index([userId, status])
  @@index([authorId])
  @@index([groupId])
}

/// Uma refeição do plano (café, almoço…), com uma ou mais opções.
model NutritionPlanMeal {
  id       String   @id @default(uuid())
  planId   String
  mealType MealType
  /// "Café da manhã", "Lanche da tarde": o nome que o profissional deu.
  name     String
  position Int

  plan    NutritionPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  options NutritionPlanOption[]
  logs    NutritionPlanLog[]

  @@index([planId])
}

/// Uma opção da refeição. Refeição com uma opção só é o caso comum; com várias,
/// o aluno escolhe qual comeu ("toque para escolher").
model NutritionPlanOption {
  id             String  @id @default(uuid())
  mealId         String
  position       Int
  /// Refeição salva criada em nome do aluno ao aceitar. Apagá-la não mexe no plano.
  mealTemplateId String?

  meal         NutritionPlanMeal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealTemplate MealTemplate?       @relation(fields: [mealTemplateId], references: [id], onDelete: SetNull)
  items        NutritionPlanItem[]
  logs         NutritionPlanLog[]

  @@index([mealId])
  @@index([mealTemplateId])
}

/// Um alimento da opção, já com os macros calculados (retrato, como
/// `MealTemplateItem`): só alimentos da base, nunca o personalizado de outra
/// conta. Sem equivalentes, a tela mostra "sem troca".
model NutritionPlanItem {
  id               String  @id @default(uuid())
  optionId         String
  position         Int
  foodId           Int?
  groupId          Int?
  foodName         String
  grams            Float
  kcal             Float
  proteinG         Float
  carbsG           Float
  fatG             Float
  nutrients        Json?
  portionLabel     String?
  portionQuantity  Float?
  /// Grupo de equivalência ("Carboidrato"), o título da folha de troca.
  equivalenceGroup String?

  option      NutritionPlanOption       @relation(fields: [optionId], references: [id], onDelete: Cascade)
  food        Food?                     @relation(fields: [foodId], references: [id], onDelete: SetNull)
  equivalents NutritionPlanEquivalent[]
  swaps       NutritionSwap[]

  @@index([optionId])
}

/// Um equivalente que o profissional liberou para o item, com a quantidade já
/// ajustada.
model NutritionPlanEquivalent {
  id              String  @id @default(uuid())
  itemId          String
  position        Int
  foodId          Int?
  groupId         Int?
  foodName        String
  grams           Float
  kcal            Float
  proteinG        Float
  carbsG          Float
  fatG            Float
  nutrients       Json?
  portionLabel    String?
  portionQuantity Float?

  item  NutritionPlanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  food  Food?             @relation(fields: [foodId], references: [id], onDelete: SetNull)
  swaps NutritionSwap[]

  @@index([itemId])
}

/// "Comi isso": a refeição registrada a partir de uma refeição do plano, num
/// dia. O dono é o da refeição (e o do plano), sem coluna de dono própria.
model NutritionPlanLog {
  id         String   @id @default(uuid())
  planMealId String
  optionId   String
  mealId     String   @unique
  /// YYYY-MM-DD no fuso da pessoa.
  date       String
  /// Item do plano -> item gravado no diário (`{ planItemId: mealItemId }`).
  /// É o que a troca usa para achar o item mesmo depois de a pessoa editar
  /// nome ou gramas no diário.
  itemLinks  Json     @default("{}")
  createdAt  DateTime @default(now())

  planMeal NutritionPlanMeal   @relation(fields: [planMealId], references: [id], onDelete: Cascade)
  option   NutritionPlanOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  meal     Meal                @relation(fields: [mealId], references: [id], onDelete: Cascade)

  /// Um "comi isso" por refeição do plano e dia: o toque duplo não duplica.
  @@unique([planMealId, date])
}

/// Troca registrada: num dia, o aluno comeu um equivalente no lugar do item.
/// "Desfazer" grava `undoneAt` e volta ao item; a linha fica como trilha do
/// diário. A equipe só vê com Alimentação liberada (`NUTRITION`).
model NutritionSwap {
  id           String    @id @default(uuid())
  planId       String
  itemId       String
  equivalentId String
  /// YYYY-MM-DD no fuso da pessoa.
  date         String
  /// Retrato do que foi comido no lugar.
  foodName     String
  grams        Float
  kcal         Float
  /// Item da refeição registrada que a troca alterou, quando o "comi isso" veio
  /// antes (ou depois). Sem FK: o item pode sumir, e a troca continua no diário.
  mealItemId   String?
  createdAt    DateTime  @default(now())
  undoneAt     DateTime?

  plan       NutritionPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  item       NutritionPlanItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  equivalent NutritionPlanEquivalent @relation(fields: [equivalentId], references: [id], onDelete: Cascade)

  @@index([planId, date])
  @@index([itemId, date])
}

// ============================================================
// WORKOUT
// ============================================================

model Exercise {
  id               Int      @id @default(autoincrement())
  name             String
  // Ver `Food.searchName` — mesma razão, mantido por `ExerciseService`.
  searchName       String   @default("")
  muscleGroup      String // "peito", "costas", "pernas", "ombro", "braço", "core", "cardio"
  // Defaults `[]` espelham o `DEFAULT '{}'` criado em
  // migrations/20260602120000_add_exercise_enrichment. Sem eles o datamodel
  // divergia do banco e o job `Prisma Checks` do CI acusava drift.
  primaryMuscles   String[] @default([])
  secondaryMuscles String[] @default([])
  equipment        String?
  level            String? // "beginner" | "intermediate" | "advanced"
  mechanic         String? // "compound" | "isolation"
  instructions     String[] @default([])
  youtubeVideoId   String?
  youtubeVideoIdPt String?
  // Para exercícios custom: dono. Null = catálogo público.
  createdByUserId  String?
  // Se esta é uma cópia editável de um exercício base, aponta para o base de origem.
  // A base correspondente é escondida das listagens do usuário (a cópia a substitui).
  clonedFromId     Int?
  /// Exercício criado por uma comunidade (Fase 7b, ADR 030), como a máquina da
  /// casa. **Imutável**: é ele, e não `groupId`, que tira o exercício do
  /// catálogo público. `groupId` cai em SetNull quando a comunidade some ou
  /// quando a equipe apaga um exercício que alguém já usa, e sem esta marca a
  /// linha (sem dono e sem comunidade) viraria catálogo de todo mundo.
  groupOwned       Boolean  @default(false)
  /// Comunidade dona, enquanto o exercício estiver no catálogo dela.
  groupId          String?
  createdAt        DateTime @default(now())

  createdBy     User?                 @relation("UserCustomExercises", fields: [createdByUserId], references: [id], onDelete: Cascade)
  clonedFrom    Exercise?             @relation("ExerciseClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones        Exercise[]            @relation("ExerciseClones")
  group         Group?                @relation("GroupExercises", fields: [groupId], references: [id], onDelete: SetNull)
  planExercises WorkoutPlanExercise[]
  sessionSets   SessionSet[]
  groupGuides   GroupExerciseGuide[]
  favoritedBy   FavoriteExercise[]

  @@unique([name, createdByUserId])
  // Nome único dentro do catálogo da comunidade. `groupId` nulo (catálogo
  // geral, exercício pessoal, exercício solto da comunidade) não colide: no
  // Postgres, NULL é distinto de NULL.
  @@unique([name, groupId])
  @@index([name])
  @@index([searchName])
  @@index([muscleGroup])
  @@index([createdByUserId])
  @@index([clonedFromId])
  @@index([groupId])
}

model WorkoutPlan {
  id             String          @id @default(uuid())
  userId         String
  name           String // "Push", "Pull", "Leg"
  /// Plano pronto da comunidade de onde este plano veio (Fase 7). Torna a
  /// adoção idempotente; arquivar o modelo não mexe na cópia.
  fromTemplateId String?
  /// Oferta da equipe de onde este plano veio (#379). Aceitar a versão nova
  /// troca os exercícios deste mesmo plano; apagar o plano não mexe na oferta.
  fromOfferId    String?
  /// Plano de séries (STRENGTH) ou circuito com timer (CIRCUIT, #380). O
  /// circuito leva a configuração em `circuit` e os exercícios em `exercises`,
  /// cada um com `repUnit` (reps ou segundos) e `targetReps` (o número).
  kind           WorkoutPlanKind @default(STRENGTH)
  /// Sessão que virou este plano no "Salvar como plano" (#381). Torna o salvar
  /// idempotente (um plano por sessão); apagar a sessão não apaga o plano.
  fromSessionId  String?
  createdAt      DateTime        @default(now())

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  circuit         CircuitConfig?
  exercises       WorkoutPlanExercise[]
  sessions        WorkoutSession[]      @relation("SessionPlan")
  fromSession     WorkoutSession?       @relation("PlanFromSession", fields: [fromSessionId], references: [id], onDelete: SetNull)
  trainingBlocks  TrainingBlock[]
  fromTemplate    GroupPlanTemplate?    @relation("PlanFromTemplate", fields: [fromTemplateId], references: [id], onDelete: SetNull)
  fromOffer       PlanOffer?            @relation("PlanFromOffer", fields: [fromOfferId], references: [id], onDelete: SetNull)
  plannedSessions PlannedSession[]

  @@unique([userId, fromSessionId])
  @@index([userId])
  @@index([userId, fromTemplateId])
  @@index([fromOfferId])
}

enum WorkoutPlanKind {
  STRENGTH
  CIRCUIT
}

/// Formatos de circuito do canvas (Al-T22). Superset, giant set e carga em %
/// de 1RM ficam para depois (#380, decisão do dono).
enum CircuitFormat {
  /// Máximo de rounds em `durationSeconds`.
  AMRAP
  /// Um exercício por minuto, em rodízio, por `durationSeconds`.
  EMOM
  /// `intervals` × (`workSeconds` de trabalho + `restSeconds` de descanso).
  TABATA
  /// `rounds` rounds no menor tempo, com `restBetweenRoundsSeconds` entre eles.
  FOR_TIME
}

/// A configuração do circuito (#380, Al-T22). Uma por plano `CIRCUIT`; só os
/// campos do formato ficam preenchidos (a API confere).
model CircuitConfig {
  id                       String        @id @default(uuid())
  planId                   String        @unique
  format                   CircuitFormat
  /// AMRAP e EMOM.
  durationSeconds          Int?
  /// Tabata.
  workSeconds              Int?
  restSeconds              Int?
  intervals                Int?
  /// For Time.
  rounds                   Int?
  restBetweenRoundsSeconds Int?

  plan WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

/// Uma linha do plano. A identidade é o `id` (e a posição é `order`): o mesmo
/// exercício pode aparecer duas vezes no plano (#378), então nada aqui é único
/// por `exerciseId`.
model WorkoutPlanExercise {
  id         String @id @default(uuid())
  planId     String
  exerciseId Int
  order      Int
  targetSets Int
  /// "8-12", "5", "AMRAP" — string pra flexibilidade. Com `repUnit = SECONDS`,
  /// a faixa é de segundos ("30-45"). Com a tabela série por série (`sets`), a
  /// API recalcula `targetSets` e `targetReps` a partir dela.
  targetReps String

  // Configuração do exercício (#378, Al-T21). Tudo opcional ou com padrão: o
  // plano antigo continua igual, e a sessão usa o padrão dela quando é nulo.
  /// Como a pessoa conta a série: repetições ou segundos (prancha).
  repUnit       PlanRepUnit   @default(REPS)
  /// Carga externa ou peso do corpo (aí `startLoadKg` é o extra).
  loadMode      PlanLoadMode  @default(WEIGHT)
  /// Carga inicial sugerida, sempre em kg (a conversão para lb é da tela).
  startLoadKg   Float?
  /// Descanso entre séries. Nulo = o padrão da sessão.
  restSeconds   Int?
  technique     PlanTechnique @default(NORMAL)
  /// Faz este e o próximo em sequência e só então descansa. Só marcação e ordem
  /// de execução (o circuito de verdade é a #380). No último exercício é ignorado.
  biSetWithNext Boolean       @default(false)
  /// Observação curta: pegada, banco, cadência.
  notes         String?

  // Meta do cardio (Al-T21d). Só faz sentido em exercício de cardio.
  cardioTarget          CardioTargetKind?
  cardioDurationSeconds Int?
  cardioDistanceMeters  Float?
  /// A faixa de FC sai da idade, na tela: aqui fica só a zona escolhida.
  cardioIntensity       CardioIntensity?

  plan     WorkoutPlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise Exercise                 @relation(fields: [exerciseId], references: [id])
  /// Série por série (Al-T21b), opcional. Vazia = séries iguais (`targetSets` × `targetReps`).
  sets     WorkoutPlanExerciseSet[]

  /// O mesmo exercício uma vez por plano: a sessão agrupa séries por exercício
  /// (#378 manteve o bloqueio; repetir fica para outra issue).
  @@unique([planId, exerciseId])
  @@index([planId])
}

/// A meta de cada série, quando a pessoa configura série por série (pirâmide,
/// aquecimento, drop). Substituída inteira a cada gravação.
model WorkoutPlanExerciseSet {
  id             String      @id @default(uuid())
  planExerciseId String
  /// 1 = primeira série.
  order          Int
  kind           PlanSetKind @default(NORMAL)
  /// Repetições, ou segundos quando a linha do plano é `repUnit = SECONDS`.
  reps           Int
  loadKg         Float?

  planExercise WorkoutPlanExercise @relation(fields: [planExerciseId], references: [id], onDelete: Cascade)

  @@unique([planExerciseId, order])
}

enum PlanRepUnit {
  REPS
  SECONDS
}

enum PlanLoadMode {
  WEIGHT
  BODYWEIGHT
}

enum PlanTechnique {
  NORMAL
  DROP_SET
  TO_FAILURE
}

enum PlanSetKind {
  WARMUP
  NORMAL
  DROP
}

enum CardioTargetKind {
  TIME
  DISTANCE
}

enum CardioIntensity {
  LIGHT
  MODERATE
  VIGOROUS
}

/// Atalho da busca de exercício (#378): o que a pessoa marca no Como fazer
/// aparece na aba Favoritos e primeiro nas sugestões. Espelha `FavoriteFood`.
model FavoriteExercise {
  id         String   @id @default(uuid())
  userId     String
  exerciseId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId, createdAt])
}

model WorkoutSession {
  id          String    @id @default(uuid())
  userId      String
  planId      String? // null = treino livre (ou o plano foi apagado: ver `fromPlan`)
  /// Retrato do plano ao começar (#381): o plano pode ser apagado depois (a FK
  /// vira nula), e a sessão segue sendo "de plano", com o nome que tinha.
  fromPlan    Boolean   @default(false)
  planName    String?
  startedAt   DateTime
  completedAt DateTime?
  notes       String?

  // Ajustes desta sessão sobre o plano, sem mexer no plano: a ordem em que a
  // pessoa decidiu fazer os exercícios (ids, na ordem; vazio = a do plano) e os
  // exercícios do plano que ela tirou deste treino. Vale só aqui — o plano
  // segue igual para a próxima vez.
  exerciseOrder      Int[] @default([])
  removedExerciseIds Int[] @default([])

  /// "Como foi o treino?" (#377): a escala de 5 do canvas, 1 Leve, 2 Firme,
  /// 3 Puxado, 4 Muito puxado, 5 No limite. Nulo = não marcou. A sensação de
  /// cada série continua no `SessionSet.rpe` (6 a 10, a mesma escala).
  feeling Int?

  /// Circuito (#380), em JSON versionado (`version: 1`): o retrato do circuito
  /// no começo (formato, configuração e exercícios, para o histórico não mudar
  /// quando o plano mudar), os toques com horário (`events`, para retomar em
  /// outra aba ou aparelho) e, no fim, o resultado (`result`: rounds, tempo de
  /// cada round, tempo final, reps). Nulo em sessão de séries. As séries de
  /// cada exercício continuam em `SessionSet`, para estatística e "previous".
  circuit Json?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       WorkoutPlan?    @relation("SessionPlan", fields: [planId], references: [id])
  sets       SessionSet[]
  checkin    WorkoutCheckin?
  savedPlans WorkoutPlan[]   @relation("PlanFromSession")
  // E um índice único PARCIAL em (userId) onde completedAt é nulo — uma sessão
  // aberta por pessoa (#350). O Prisma não o descreve: está na migration
  // 20261026120000_one_open_workout_session.

  @@index([userId, startedAt])
}

model SessionSet {
  id         String @id @default(uuid())
  sessionId  String
  exerciseId Int
  setNumber  Int

  // Campos de força — opcionais pois SessionSet também cobre cardio
  weightKg Float?
  reps     Int?
  rpe      Float? // 1-10, opcional

  // Campos de cardio — opcionais pois também cobre força
  durationSeconds Int?
  distanceMeters  Float?
  avgHeartRate    Int?
  kcalBurned      Int?

  notes String?

  /// Chave que o app gera ao tocar "Concluir série" (#377). O mesmo toque
  /// reenviado (duplo toque, rede que cai e volta) devolve a série já gravada
  /// em vez de criar outra. Nula para quem não manda (MCP, versões antigas).
  clientKey String?

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])

  @@unique([sessionId, clientKey])
  @@index([sessionId])
  @@index([exerciseId])
}

/// Respostas rápidas depois do treino (#377, parte da #304): a folha
/// "Perguntas da equipe" do fim do treino. Uma por sessão, e todas opcionais.
/// `skipped` grava o "Pular": a equipe vê só que a pessoa pulou.
///
/// Dado do aluno: a equipe lê só pela porta do painel, com Treino liberado e
/// linha em `ProfessionalAccessLog` (ADR 014). Escalas de 1 a 5; a faixa é
/// conferida por CHECK na migration.
model WorkoutCheckin {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  /// O dono da sessão, gravado pelo serviço a partir dela, nunca do corpo.
  userId       String
  skipped      Boolean  @default(false)
  difficulty   Int?
  fatigue      Int?
  pain         Boolean?
  painLocation String?
  motivation   Int?
  note         String?
  answeredAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, answeredAt])
}

// ============================================================
// PERIODIZAÇÃO (#145 — ADR 019)
// ============================================================

/// Bloco de periodização: de 3 a 6 semanas (acúmulo, pico e 1 deload no fim) sobre
/// um plano. Os blocos de 4 semanas de antes da #379 seguem iguais.
///
/// O que estas tabelas guardam é **intenção**, e só ela: o bloco que o usuário
/// aceitou, com os multiplicadores congelados no dia em que aceitou. Derivar a
/// intenção do histórico faria a semana mudar sozinha no dia em que o template do
/// código mudasse, e não haveria o que explicar a quem está no meio do bloco.
///
/// O que **não** mora aqui é o andamento — sessões feitas, semanas empurradas,
/// bloco vencido ou abandonado por ausência. Isso é função pura do histórico de
/// `WorkoutSession` e é recalculado em toda leitura (`helpers/reconcile-block.ts`).
/// Guardar contador de andamento criaria uma cópia que mente sozinha quando uma
/// sessão é apagada ou registrada retroativamente — e obrigaria a gravar durante
/// um `GET`, que é o que `get_training_block` promete não fazer (`readOnlyHint`).
model TrainingBlock {
  id     String  @id @default(uuid())
  userId String
  planId String?

  kind       TrainingBlockKind   @default(hypertrophy)
  /// YYYY-MM-DD no fuso do usuário, mesma escolha de `StepLog.date`.
  startDate  String
  weeksTotal Int                 @default(4)
  status     TrainingBlockStatus @default(active)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan  WorkoutPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  weeks TrainingBlockWeek[]

  @@index([userId, status])
}

model TrainingBlockWeek {
  id         String @id @default(uuid())
  blockId    String
  /// 1..weeksTotal
  weekNumber Int
  /// "accumulation" | "peak" | "deload" (os mesmos três desde a #379, que só
  /// mudou quantas semanas de cada um o bloco tem)
  focus      String

  /// Multiplicadores gravados na linha, não lidos do template do código: um bloco
  /// em curso não pode mudar debaixo do usuário quando o template mudar.
  ///
  /// Consequência para quem depura: ver 1.025 aqui e 1.05 em `block-template.ts`
  /// **não** é bug — é um bloco criado antes da mudança do template.
  intensityFactor Float
  volumeFactor    Float

  /// Segunda-feira **planejada** da semana, YYYY-MM-DD — o combinado, não o que
  /// aconteceu. A reancoragem por semana perdida sai derivada na leitura
  /// (`effectiveWeekStart`); esta coluna nunca é reescrita.
  weekStart      String
  sessionsTarget Int

  block TrainingBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, weekNumber])
  @@index([blockId])
}

enum TrainingBlockKind {
  strength
  hypertrophy
}

enum TrainingBlockStatus {
  active
  completed
  abandoned
}

// ============================================================
// PLANO RECEBIDO E AGENDA DE TREINOS (#379, ADR 014 e ADR 042)
// ============================================================

/// PENDING: chegou e espera o aceite. ACCEPTED: a versão em uso (uma por
/// oferta). DECLINED: a pessoa recusou ("Desfazer" volta a PENDING), ou, numa
/// atualização, manteve a versão atual. SUPERSEDED: veio uma versão mais nova
/// antes da resposta, ou outra versão foi aceita depois desta.
enum PlanOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  SUPERSEDED
}

/// CALENDAR: o plano tem datas, e o aceite gera as sessões da agenda.
/// FLEXIBLE: sem datas; a agenda só calcula a próxima sessão.
enum PlanSchedule {
  CALENDAR
  FLEXIBLE
}

/// Plano de treino que a equipe mandou para um aluno (#379). A linha é do ALUNO
/// (`userId`): entra no export dele e some com a conta dele. Só nasce com
/// `ProfessionalLink` ativo entre o aluno e a equipe remetente; recusar não
/// mexe no vínculo nem nos consentimentos.
///
/// O conteúdo mora nas versões (`PlanOfferVersion`): atualizar é versão nova, e
/// nada muda no plano do aluno sem o aceite dela (ADR 014: a cópia é dele).
model PlanOffer {
  id        String   @id @default(uuid())
  userId    String
  /// Quem enviou. Nulo quando apagou a conta: a oferta fica, sem o nome.
  authorId  String?
  /// Comunidade em que a oferta foi enviada. Exercício dela viaja por referência.
  groupId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation("PlanOfferSubject", fields: [userId], references: [id], onDelete: Cascade)
  author   User?              @relation("PlanOfferAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  group    Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  versions PlanOfferVersion[]
  /// O plano que o aceite criou na conta do aluno.
  plans    WorkoutPlan[]      @relation("PlanFromOffer")

  @@index([userId])
  @@index([authorId])
  @@index([groupId])
}

/// Uma versão da oferta: o retrato congelado do plano (`plan-snapshot.ts`), as
/// datas e o recado. O "o que mudou" é o diff entre o retrato da versão aceita
/// e o desta, calculado na leitura.
model PlanOfferVersion {
  id              String          @id @default(uuid())
  offerId         String
  /// 1, 2, 3… dentro da oferta. Aparece como "v2".
  version         Int
  status          PlanOfferStatus @default(PENDING)
  title           String
  snapshot        Json
  snapshotVersion Int
  schedule        PlanSchedule
  /// Só no CALENDAR: a primeira segunda-feira (YYYY-MM-DD), quantas semanas e
  /// os dias da semana ISO (1 = segunda … 7 = domingo).
  startDate       String?
  weeks           Int?
  weekdays        Int[]           @default([])
  /// Recado da equipe, texto puro.
  note            String?
  sentAt          DateTime        @default(now())
  /// Quando a pessoa aceitou, recusou ou a versão foi substituída.
  respondedAt     DateTime?

  offer PlanOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, version])
  @@index([offerId, status])
}

/// PLANNED: no dia combinado. RESCHEDULED: a pessoa remarcou (`originalDate`
/// guarda o dia de antes). "Feito" e "não feito" não ficam aqui: saem das
/// sessões concluídas na leitura (ADR 019), e a agenda não registra presença.
enum PlannedSessionStatus {
  PLANNED
  RESCHEDULED
}

/// Uma sessão da agenda de treinos (Al-T24): o plano de calendário no dia.
/// Informativa (ADR 042): sem reserva, sem presença. Só o aceite de um plano
/// de calendário cria linhas; plano flexível não cria nenhuma.
model PlannedSession {
  id             String               @id @default(uuid())
  userId         String
  planId         String
  /// Versão da oferta que gerou a sessão. Aceitar uma versão nova refaz as
  /// sessões de hoje em diante; as que passaram ficam.
  offerVersionId String?
  /// YYYY-MM-DD no fuso da pessoa.
  date           String
  /// 1, 2, 3… na ordem do plano.
  order          Int
  status         PlannedSessionStatus @default(PLANNED)
  originalDate   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([planId, date])
}

// ============================================================
// STEPS
// ============================================================

model StepLog {
  id       String     @id @default(uuid())
  userId   String
  // YYYY-MM-DD no fuso do usuário. String pra evitar ambiguidade de timezone.
  date     String
  steps    Int
  source   StepSource @default(MANUAL)
  loggedAt DateTime   @default(now())
  notes    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Múltiplos logs por dia permitidos (várias fontes, correções, sync parcial).
  // Política de "valor do dia" definida em ADR 007: maior valor entre os logs
  // do dia. Implementada em StepLogService.getStepsForDate.
  @@index([userId, date])
  @@index([userId, loggedAt])
}

enum StepSource {
  MANUAL
  GOOGLE_FIT
  APPLE_HEALTH
  HEALTH_CONNECT
  STRAVA
  GARMIN
  FITBIT
  WEBHOOK
}

// ============================================================
// PROGRESS
// ============================================================

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  weightKg  Float
  loggedAt  DateTime
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// Hidratação. Múltiplos logs por dia esperados (cada copo é um log).
// Política do "valor do dia" = SOMA (diferente de StepLog, que é MAX).
model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  // YYYY-MM-DD no fuso do usuário.
  date     String
  ml       Int
  loggedAt DateTime @default(now())
  notes    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, loggedAt])
}

// ============================================================
// ENGAJAMENTO
// ============================================================

// Conquista desbloqueada. Guarda só o fato e a data — a definição (título,
// critério, ícone) vive em código, em `achievement-catalog.ts`. Guardar a
// definição no banco obrigaria migration a cada conquista nova e deixaria duas
// versões da mesma conquista coexistindo.
//
// Streak NÃO tem tabela: continua derivado de Meal/WorkoutSession/StepLog. Uma
// tabela criaria um segundo lugar onde a verdade mora — apagar uma refeição
// teria de decrementar o contador, e errar isso é invisível.
model UserAchievement {
  id String @id @default(uuid())

  userId String
  // Chave do catálogo: "first_meal", "first_workout", "first_pr", ...
  key    String

  unlockedAt DateTime @default(now())

  // Contexto do desbloqueio, para a tela contar a história:
  // `{ "weightKg": 80 }`. Json porque cada conquista tem um contexto diferente
  // — mesma razão de `MealItem.nutrients` (ADR 009).
  context Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uma vez só por usuário. É o que torna a reavaliação idempotente.
  //
  // Sem `@@index([userId])`: o unique composto já é um índice com `userId` à esquerda, e é ele
  // que atende o `findMany where userId` da listagem. Um índice só de `userId` seria pago em
  // toda escrita sem servir a nenhuma consulta que o composto não sirva.
  @@unique([userId, key])
}

// ============================================================
// PERSONAL GOALS
// ============================================================

// Metas dinâmicas definíveis pelo usuário (via PWA ou Claude/MCP).
// Distintas de `UserGoals` (que cobre só macros nutricionais).
// `currentValue` é derivado em tempo de leitura quando `kind` tem fonte
// (weight, workout_frequency, step_count). Para `body_fat` e `custom`,
// o Claude reporta valores via `lastReportedValue`.
model Goal {
  id                String     @id @default(uuid())
  userId            String
  kind              GoalKind
  title             String
  description       String?
  startValue        Float
  targetValue       Float
  unit              String
  // Reportado pelo Claude para metas sem fonte automática (body_fat, custom).
  lastReportedValue Float?
  deadline          DateTime?
  status            GoalStatus @default(active)
  createdAt         DateTime   @default(now())
  completedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, kind])
}

enum GoalKind {
  weight
  body_fat
  workout_frequency
  step_count
  custom
}

// Metas de nutrientes personalizadas (ex.: limitar sódio, açúcar; atingir fibra).
// Distintas de `UserGoals` (macros fixos). Min/max em range (ADR 006/D6). O valor
// do dia é agregado de `MealItem.nutrients[nutrientKey]`. Ver ADR 009.
model NutrientTarget {
  id          String   @id @default(uuid())
  userId      String
  nutrientKey String // "sodium_mg", "sugar_g", "fiber_g", "caffeine_mg", ...
  label       String // "Sódio", "Açúcar"
  unit        String // "mg", "g"
  min         Float?
  max         Float?
  period      String   @default("daily") // v1: apenas "daily"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nutrientKey])
  @@index([userId])
}

enum GoalStatus {
  active
  completed
  expired
  archived
}

// ============================================================
// B2B — GRUPOS E VÍNCULO PROFISSIONAL (ADR 014)
// ============================================================
//
// Regra que governa este bloco inteiro: **estar num grupo, em qualquer papel,
// não dá acesso a nenhum dado de saúde de ninguém**. Papel governa administração
// de grupo. Leitura entre contas vem exclusivamente de uma linha de
// `ProfessionalLink` que o próprio titular criou, e passa por um único método
// (`ProfessionalAccessService.assertReadable`). É o que mantém os services de
// domínio — meal, workout, weight, steps, water, goals — inconscientes de que
// grupo existe.

enum GroupType {
  /// Academia paga a IA dos alunos. Único tipo que gera cobrança (#158).
  SPONSORED
  /// Criador de conteúdo / influenciador. Ninguém paga IA.
  SOCIAL
}

enum GroupRole {
  /// Gere grupo, membros e cobrança. Lê dado de saúde só com vínculo (ADR 026).
  OWNER
  /// Pode receber vínculo de leitura e oferecer plano.
  PROFESSIONAL
  /// Publica conteúdo. Lê dado individual só com vínculo (ADR 026).
  CREATOR
  /// Aluno/fã. O próprio dado, sempre.
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  LEFT
  REMOVED
  /// Removido e barrado: o código e o convite não reabrem a porta (Fase 8b).
  BANNED
}

/// Quem acha a comunidade (ADR 025/026). PRIVATE só por convite ou código.
enum GroupVisibility {
  PUBLIC
  PRIVATE
}

/// Como se entra pelo código (`slug`). Convite já é a aprovação: entra ACTIVE.
enum JoinPolicy {
  /// Entra na hora.
  OPEN
  /// Fica pendente até o dono aprovar (o comportamento de antes).
  APPROVAL
  /// O código não abre a porta; só convite.
  INVITE_ONLY
}

/// Categorias de dado que podem ser consentidas, independentes entre si.
/// A ADR 014 nomeia treino, nutrição, peso e passos; a #155 pede também metas.
/// O enum é o superconjunto — nenhuma delas implica outra.
enum ShareScope {
  WORKOUT
  NUTRITION
  /// Peso e medidas corporais.
  BODY
  /// Água e passos.
  HABITS
  GOALS
  /// Fotos das refeições (ADR 038, #374). Nunca implícita em `NUTRITION`:
  /// quem compartilha Alimentação mostra só os números.
  MEAL_PHOTOS
}

model Group {
  id          String          @id @default(uuid())
  type        GroupType
  name        String
  /// Usado no link de convite e na URL do painel. Público por natureza.
  slug        String          @unique
  ownerId     String
  description String?
  /// Fuso da comunidade (desafios e ranking, Fase 8).
  timezone    String          @default("America/Sao_Paulo")
  visibility  GroupVisibility @default(PRIVATE)
  joinPolicy  JoinPolicy      @default(APPROVAL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Cascade e não Restrict de propósito: com Restrict, `delete_my_account` de um
  // dono de academia falharia — um direito da LGPD travado por dívida comercial.
  // Apagar a conta do dono apaga grupo, memberships e vínculos, e **nenhum dado
  // de aluno é tocado**, porque nunca esteve sob o grupo. Fatura em aberto é
  // problema da #158, não deste FK.
  owner                 User                 @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships           GroupMembership[]
  links                 ProfessionalLink[]
  aiUsage               AiUsage[]
  invites               GroupInvite[]
  seatPool              GroupSeatPool?
  /// Avatar da comunidade (ADR 028).
  avatarFileId          String?              @unique
  avatarFile            MediaFile?           @relation("GroupAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  mediaFiles            MediaFile[]          @relation("GroupMedia")
  planTemplates         GroupPlanTemplate[]
  tips                  GroupTip[]
  /// Equipamentos que a academia tem (Fase 7b), da lista do catálogo. Serve
  /// ao filtro "Na minha academia".
  equipment             String[]             @default([])
  /// Equipamentos que a academia nomeou por conta própria ("Hack 45° da casa"),
  /// fora da lista. Valem no filtro "Na minha academia" contra o equipamento
  /// gravado no exercício, e aparecem no editor de exercício.
  customEquipment       String[]             @default([])
  exercises             Exercise[]           @relation("GroupExercises")
  exerciseGuides        GroupExerciseGuide[]
  /// O agente da comunidade no chat (Fase 7c, ADR 031).
  agent                 GroupAgent?
  agentChats            Conversation[]       @relation("ConversationAgent")
  /// Desafios da comunidade (Fase 8a, ADR 027).
  challenges            GroupChallenge[]
  /// Planos alimentares que a equipe mandou a alunos (#376).
  nutritionPlans        NutritionPlan[]
  /// Planos de treino que a equipe mandou a alunos (#379).
  planOffers            PlanOffer[]
  /// Quem publica no mural (Fase 8b, ADR 032).
  postPolicy            PostPolicy           @default(ALL_MEMBERS)
  posts                 GroupPost[]
  /// O que quem entra como membro precisa compartilhar com a equipe. Cobrado
  /// na entrada (código ou convite) e ao tirar um escopo já compartilhado;
  /// quem entrou antes de o dono mudar a lista não deve o que nunca compartilhou.
  requiredSharingScopes ShareScope[]         @default([])

  @@index([ownerId])
  @@index([type])
}

model GroupMembership {
  id            String           @id @default(uuid())
  groupId       String
  userId        String
  role          GroupRole
  status        MembershipStatus @default(INVITED)
  invitedAt     DateTime         @default(now())
  joinedAt      DateTime?
  leftAt        DateTime?
  /// O que a pessoa aceitou compartilhar com a equipe ao entrar (ADR 026).
  /// Registro do aceite; a autorização de fato são os `ProfessionalLink`.
  consentScopes ShareScope[]     @default([])
  consentAt     DateTime?
  /// Entra nas estatísticas agregadas da comunidade (opt-in, ADR 026 §6).
  statsOptIn    Boolean          @default(false)
  /// Apelido na comunidade: como a pessoa aparece no ranking dos desafios
  /// (Fase 8a). Nulo até a primeira vez que ela entra num desafio.
  displayName   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  group            Group                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatAssignments  GroupSeatAssignment[]
  challengeEntries GroupChallengeParticipant[]
  /// O mural (Fase 8b): o que a pessoa publicou, reagiu, comentou e denunciou.
  posts            GroupPost[]                 @relation("PostAuthor")
  postsRemoved     GroupPost[]                 @relation("PostRemovedBy")
  postReactions    GroupPostReaction[]
  postComments     GroupPostComment[]          @relation("CommentAuthor")
  commentsRemoved  GroupPostComment[]          @relation("CommentRemovedBy")
  reportsMade      GroupPostReport[]           @relation("ReportReporter")
  reportsResolved  GroupPostReport[]           @relation("ReportResolvedBy")

  // Um papel por pessoa por grupo. É o que torna estruturalmente impossível
  // o acúmulo de papéis que a #156 pede para evitar: não existe linha em que
  // alguém seja OWNER e PROFESSIONAL do mesmo grupo.
  @@unique([groupId, userId])
  @@index([userId, status])
  @@index([groupId, status])
  @@index([groupId, role])
}

/// A ÚNICA autorização de leitura entre contas do produto (ADR 014).
/// Tabela, e não colunas em `User`: duas colunas assumiriam para sempre no
/// máximo um profissional por pessoa, e corrigir isso depois seria migration
/// de dado sobre permissão de leitura de dado de saúde.
model ProfessionalLink {
  id             String       @id @default(uuid())
  /// Titular do dado. Quem consente — e a única pessoa que pode consentir.
  subjectUserId  String
  /// Quem passa a poder ler. Nunca inferido de papel: sempre gravado aqui.
  professionalId String
  /// Contexto. Sair do grupo revoga todo vínculo com este `groupId`.
  groupId        String
  /// Consentimento por categoria. Vazio é estado válido e significa nada.
  scopes         ShareScope[]
  grantedAt      DateTime     @default(now())
  /// Revogação NÃO apaga a linha — é o que responde "quem teve acesso a quê,
  /// quando", que o THREAT_MODEL hoje lista como ausência conhecida.
  revokedAt      DateTime?
  /// "subject" | "group_owner" | "left_group" | "membership_removed" | "superseded"
  revokedReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subject      User                    @relation("LinkSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  professional User                    @relation("LinkProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  group        Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accessLogs   ProfessionalAccessLog[]

  // Sem @@unique em (subject, professional, group): conceder de novo depois de
  // revogar cria linha NOVA. Unicidade forçaria UPDATE e destruiria a trilha —
  // é a "correção" errada mais provável numa revisão futura.
  @@index([professionalId, revokedAt])
  @@index([subjectUserId, revokedAt])
  @@index([groupId, revokedAt])
}

/// Trilha de auditoria. Escrita em UM lugar só (`ProfessionalAccessService`),
/// inclusive nas negativas — "tentou ver o que não podia" é o registro que mais
/// importa.
model ProfessionalAccessLog {
  id             String     @id @default(uuid())
  /// Nulo quando não havia vínculo (negativa) ou quando o vínculo sumiu junto
  /// com a conta do profissional. A trilha do titular sobrevive aos dois casos.
  linkId         String?
  /// String pura, sem FK: se o profissional apagar a conta, o aluno continua
  /// conseguindo responder "quem olhou meu dado".
  professionalId String
  subjectUserId  String
  scope          ShareScope
  /// Vocabulário do produto: "list_workout_sessions", "get_student_progress".
  action         String
  denied         Boolean    @default(false)
  at             DateTime   @default(now())

  link    ProfessionalLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  subject User              @relation("AccessLogSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([subjectUserId, at])
  @@index([professionalId, at])
  @@index([linkId, at])
}

// ============================================================
// CHAT COM IA HOSPEDADA (#247, #249)
// ============================================================

/// Uma conversa do usuário com a IA hospedada. O histórico mora **aqui**, e não
/// no agente: o `apps/agent` não tem credencial de Postgres e não vai ter
/// (ADR 015), então quem guarda é quem já é dono do isolamento.
model Conversation {
  id           String  @id @default(uuid())
  userId       String
  /// Derivado da primeira mensagem, para a lista de conversas ter o que mostrar.
  /// Nulo até o primeiro turno completar.
  title        String?
  /// A comunidade cujo agente conduz a conversa (Fase 7c), escolhida quando a
  /// conversa nasce. Nulo é o assistente da Fatia. `SetNull`: apagar a
  /// comunidade devolve a conversa ao assistente da Fatia sem apagar nada.
  agentGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentGroup Group?        @relation("ConversationAgent", fields: [agentGroupId], references: [id], onDelete: SetNull)
  messages   Message[]
  /// As gravações automáticas feitas nesta conversa (#385). Somem com ela.
  autoWrites AiAutoWrite[]

  /// A listagem é sempre "minhas conversas, mais recente primeiro".
  @@index([userId, updatedAt])
  @@index([agentGroupId])
}

/// Papel de quem falou. Minúsculo e com estes dois nomes de propósito: é o
/// vocabulário que o agente já usa no corpo da requisição, então não existe
/// tradução entre a linha do banco e o que viaja — e tradução entre camadas foi
/// exatamente o que custou caro na #157.
enum MessageRole {
  user
  assistant
}

enum MessageReview {
  like
  dislike
}

model Message {
  id             String         @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  /// Quais tools o agente chamou neste turno, na ordem, como `[{ "name": "log_meal" }]`.
  /// Existe para que a ação continue auditável **depois de recarregar a página** —
  /// sem isso, "o agente registrou uma refeição" só aparece durante o streaming e
  /// some no F5, que é o oposto de auditável.
  ///
  /// Só o nome, e não o payload da tool: o argumento de uma chamada carrega dado
  /// de saúde e já está persistido no domínio de destino. Guardar de novo aqui
  /// criaria uma segunda cópia, com retenção própria, de dado que o usuário apaga
  /// no lugar certo.
  tools          Json?
  /// Estado do turno do assistente: `{ "status": "completed" | "interrupted" | "error" }`,
  /// e, **só enquanto a pausa está aberta**, `interrupt: { id, value }` — a pergunta ou a
  /// escrita que espera a pessoa (ADR 023). É o que faz o card de confirmação voltar
  /// depois de um F5. O `value` de uma confirmação carrega os argumentos da escrita
  /// proposta; por isso ele sai da linha no turno seguinte (`clearPauses`), seja qual
  /// for a resposta: aprovado, vira dado no domínio de destino; recusado, não é dado.
  metadata       Json?
  /// O `runId` do agente que produziu esta resposta. Liga o voto da pessoa ao turno.
  runId          String?
  /// O voto da pessoa sobre a resposta (👍/👎), e por que, quando ela quis dizer.
  review         MessageReview?
  reviewReasons  String[]       @default([])
  reviewNote     String?
  createdAt      DateTime       @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// As fotos que a pessoa mandou nesta mensagem, guardadas no bucket (ADR 046).
  photos       MediaFile[]  @relation("ChatPhoto")

  /// **Sem `userId` aqui, de propósito.** O dono é a conversa, e uma segunda
  /// coluna de dono é uma segunda verdade que pode divergir da primeira — o
  /// caminho mais curto para uma escrita entre contas do tipo da #204. Toda
  /// leitura e escrita de mensagem passa por um `conversationId` que o
  /// `ConversationService` já amarrou ao `userId` verificado.
  @@index([conversationId, createdAt])
}

/// O que o assistente do chat guardou sobre a pessoa, a pedido dela ("lembra que não
/// como carne"). Entra no prompt de toda conversa, cercado como dado.
///
/// Escrita só pela tool `save_memory` (CONFIRMABLE: a pessoa aprova o texto exato na tela);
/// apagada pela `forget_memory` ou pela gaveta de memórias do chat. Vai no `export_my_data` e
/// morre com a conta pelo cascade.
model UserMemory {
  id        String          @id @default(uuid())
  userId    String
  content   String
  /// Preferência, rotina, treino ou hábito (prancha Al-M9, #385). Nulo nas memórias de antes
  /// da categoria: a tela mostra só a data, sem chutar uma categoria.
  category  MemoryCategory?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Do que é a memória (prancha Al-M9). Nunca vista pela equipe.
enum MemoryCategory {
  PREFERENCE
  ROUTINE
  TRAINING
  HABIT
}

/// As categorias do modo automático (ADR 039, item 1).
enum AiWriteCategory {
  /// Refeição, água, peso e passos.
  DAY_LOG
  /// Sessão, séries e plano.
  WORKOUT
  GOALS
  MEMORIES
}

/// Perguntar antes (padrão) · Automático · Desligado.
enum AiWriteMode {
  ASK
  AUTO
  OFF
}

/// O modo de uma categoria para uma pessoa (Al-M24, #385). Sem linha é `ASK`: o padrão nunca é
/// gravado, para mudar o padrão não exigir migration de dado.
model AiWriteModeSetting {
  userId    String
  category  AiWriteCategory
  mode      AiWriteMode
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

/// Uma gravação que a IA fez sozinha (modo Automático, ADR 039 item 3), com o que é preciso para
/// o Desfazer: os argumentos, o resultado e o retrato de antes. É uma segunda cópia de dado de
/// saúde, e por isso vive só enquanto a conversa vive (cascata) e o Desfazer vale por pouco tempo
/// (`AUTO_WRITE_UNDO_MS`); o retrato sai da linha quando ela é desfeita.
model AiAutoWrite {
  id             String           @id @default(uuid())
  userId         String
  conversationId String
  /// O turno do chat que pediu (o token do `ChatRun` da API, mandado ao agente).
  runId          String
  /// A resposta à mesma mensagem da pessoa, atravessando retomadas e "Continuar": o teto de
  /// gravações por resposta conta por ela (ADR 039, item 4).
  answerKey      String
  toolCallId     String
  tool           String
  /// Fica depois da limpeza: é metadado, não dado de saúde.
  category       AiWriteCategory?
  /// Argumentos, resultado, retrato de antes, estado logo depois e as linhas do cartão. Cópias de
  /// dado de saúde: somem no Desfazer, quando o registro some e quando o prazo do Desfazer acaba.
  input          Json?
  result         Json?
  before         Json?
  after          Json?
  card           Json?
  createdAt      DateTime         @default(now())
  /// `null` = gravação em andamento (a linha nasce antes da escrita, como trava e prova).
  doneAt         DateTime?
  undoneAt       DateTime?
  /// Quando as cópias acima foram apagadas.
  clearedAt      DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, toolCallId])
  @@index([conversationId, answerKey])
  @@index([createdAt])
}

/// O que a pessoa aceitou antes de a IA hospedada mandar algo a terceiros (#384, Apple 5.1.2).
enum AiConsentKind {
  /// "Antes de conversar": mensagens e dados consultados vão ao provedor do modelo.
  CHAT
  /// "Buscar na web?": só o texto da pergunta vai ao serviço de busca.
  WEB_SEARCH
}

/// Um aceite, com a versão do texto lido. Texto novo é versão nova e pede aceite de novo: a
/// linha antiga fica, porque é a prova do que a pessoa leu e quando. Sai no export e morre com
/// a conta.
model AiConsent {
  id         String        @id @default(uuid())
  userId     String
  kind       AiConsentKind
  version    String
  acceptedAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, version])
}

/// Livro-caixa da inferência que a **Fatia** paga (#135).
///
/// A lógica da cota já existia em `apps/api/src/ai/ai-quota.ts` desde a #135, sem
/// nada que somasse o gasto — `nutrition/inference-throttler.guard.ts` registra a
/// ausência com todas as letras. Esta tabela é essa soma, e é ela que faz
/// `assertAiQuota` ser reuso e não um segundo mecanismo de cota.
///
/// O que **não** entra aqui: chamada que sai do Claude do próprio usuário pelo
/// `/mcp`. Aquele custo é dele, não nosso (ADR 018).
model AiUsage {
  id String @id @default(uuid())

  /// Nulo quando a conta foi apagada — ver `onDelete: SetNull` abaixo.
  userId  String?
  /// Qual caminho gastou: "chat" hoje; visão e áudio quando a #139/#141 passarem
  /// a registrar. Serve para o operador saber onde o orçamento foi, e não muda
  /// nenhuma decisão de cota — o teto é do dia inteiro, somando tudo.
  feature String
  /// Modelo que o agente reportou. String vazia quando ele não reportou nada, que
  /// é o caso em que `pricingKnown` nasce falso.
  model   String

  /// Micro-unidades da moeda, inteiro. Ver `ai-pricing.ts` para a escala.
  costMicros   Int
  /// Quem paga esta chamada (ADR 024/025). Nulo nas linhas anteriores ao plano.
  paidBy       AiPaidBy?
  /// Comunidade que pagou, quando `paidBy = GROUP` (assentos, Fase 5).
  groupId      String?
  /// `false` = este custo **não foi medido**, e o `0` ao lado não significa
  /// "grátis". É o que impede a cota de se desligar sozinha e em silêncio quando
  /// a medição se perde (`AiQuotaSpend.unpricedCalls`).
  pricingKnown Boolean

  createdAt DateTime @default(now())

  /// `SetNull`, e não `Cascade`: o teto **global** do dia mede dinheiro que já
  /// saiu do caixa, e apagar a conta não desfaz a fatura. Com `Cascade`, quem
  /// gastasse o orçamento da instância e apagasse a conta em seguida devolveria a
  /// cota global ao zero. A linha órfã não guarda nada pessoal — id, papel e
  /// conteúdo vão embora com o usuário; aqui fica um custo e um modelo.
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  /// Os dois `where` da janela: o do usuário e o da instância inteira.
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([groupId])
}

// ─── Plano Free/PRO (ADR 024) ────────────────────────────────────────────────
// O plano só governa a IA hospedada (chat, ditado, foto de refeição). Nenhum
// registro, leitura ou exportação fica atrás de pagamento.

enum PlanTier {
  FREE
  PRO
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

/// De onde veio a assinatura. `MANUAL` é cortesia concedida pela equipe
/// (`pnpm billing:grant-pro`), também usada pelo E2E. Assento de comunidade
/// não entra aqui: tem tabelas próprias (ADR 025, Fase 5).
enum SubscriptionSource {
  ASAAS
  APPLE
  GOOGLE
  MANUAL
}

/// `PENDING` = checkout aberto e ainda não pago, não dá direito à IA.
/// `CANCELED` = encerrada pelo provedor. Cancelar pelo app só marca
/// `cancelAtPeriodEnd`, e o PRO vale até `currentPeriodEnd`.
enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum AiPaidBy {
  USER
  GROUP
  FREE
  /// Instância sem exigência de plano (`AI_REQUIRES_PLAN=false`, self-host).
  INSTANCE
}

model UserSubscription {
  id       String             @id @default(uuid())
  userId   String
  tier     PlanTier           @default(PRO)
  source   SubscriptionSource
  status   SubscriptionStatus
  interval BillingInterval?

  /// Id da assinatura no provedor (Asaas `sub_…`, RevenueCat original
  /// transaction id). Nulo em `MANUAL`.
  providerRef String?
  /// Produto da loja (`fatia_pro_mensal`…). Nulo fora das lojas.
  productId   String?

  currentPeriodEnd  DateTime?
  /// Fim da carência de inadimplência (`decideAiTier`).
  graceEndsAt       DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  /// Link de pagamento do Asaas enquanto `PENDING`. Não vai no export.
  paymentUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, providerRef])
  @@index([userId, status])
}

/// Idempotência dos webhooks: o mesmo evento entregue duas vezes é no-op.
/// `payload` guarda só o necessário para auditar (ids, tipo, status, datas),
/// nunca CPF, e-mail ou cartão.
model BillingWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
  @@index([receivedAt])
}

/// Convite para a comunidade (Fase 5). Só o hash do token fica no banco: o link
/// `/c/<token>` aparece uma vez, para quem criou. Com e-mail, vale só para a
/// conta com aquele e-mail e uma vez; sem e-mail, é link compartilhável.
model GroupInvite {
  id          String    @id @default(uuid())
  groupId     String
  /// sha256 do token, em hex.
  tokenHash   String    @unique
  /// Apagado 30 dias depois do uso ou da expiração (DATA_RETENTION.md).
  email       String?
  role        GroupRole
  createdById String?
  /// null = sem limite até expirar.
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User? @relation("GroupInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([groupId, revokedAt])
  @@index([createdById])
}

/// Assentos de IA que a comunidade paga (ADR 025). Um pool por comunidade;
/// mesma máquina de estados da assinatura pessoal.
model GroupSeatPool {
  id                String             @id @default(uuid())
  groupId           String             @unique
  seats             Int
  /// Redução pedida: vale na próxima renovação.
  nextPeriodSeats   Int?
  unitPriceCents    Int
  status            SubscriptionStatus
  /// Id da assinatura no Asaas. null = pool de cortesia (script de dev).
  providerRef       String?            @unique
  currentPeriodEnd  DateTime?
  graceEndsAt       DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  canceledAt        DateTime?
  paymentUrl        String?
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  group       Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignments GroupSeatAssignment[]
  adjustments GroupSeatAdjustment[]
  invoices    GroupSeatInvoice[]
}

/// Quem recebeu um assento. No máximo um ativo por membership (índice único
/// parcial `revokedAt IS NULL`, criado no SQL da migration).
model GroupSeatAssignment {
  id           String    @id @default(uuid())
  poolId       String
  membershipId String
  assignedById String?
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?

  pool       GroupSeatPool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([poolId, revokedAt])
  @@index([membershipId, revokedAt])
}

enum SeatInvoiceKind {
  /// Mensalidade da assinatura dos assentos.
  SUBSCRIPTION
  /// Cobrança avulsa proporcional de um aumento.
  ADJUSTMENT
}

enum SeatInvoiceStatus {
  PENDING
  PAID
  OVERDUE
  /// Apagada, estornada ou contestada.
  VOID
}

/// Histórico de cobranças dos assentos, para o painel do dono (Fase 6). Uma
/// linha por cobrança do Asaas, atualizada a cada evento dela no webhook — é
/// cópia do que o provedor diz, e não fonte de verdade de direito nenhum.
model GroupSeatInvoice {
  id                String            @id @default(uuid())
  poolId            String
  /// Id da cobrança no Asaas (`pay_…`).
  providerPaymentId String            @unique
  kind              SeatInvoiceKind
  amountCents       Int
  /// Vencimento, `YYYY-MM-DD` no fuso do provedor.
  dueDate           String?
  status            SeatInvoiceStatus
  /// Página da fatura no Asaas.
  invoiceUrl        String?
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  pool GroupSeatPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId, createdAt])
}

/// Aumento de assentos no meio do ciclo: a cobrança avulsa proporcional.
model GroupSeatAdjustment {
  id               String             @id @default(uuid())
  poolId           String
  fromSeats        Int
  toSeats          Int
  amountCents      Int
  /// Id da cobrança avulsa no Asaas. null = abaixo do mínimo, não cobrada.
  providerChargeId String?            @unique
  status           SubscriptionStatus
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  pool GroupSeatPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
}

// ============================================================
// MÍDIA (ADR 028)
// ============================================================

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaStatus {
  /// URL de envio emitida, objeto ainda não conferido.
  PENDING
  READY
}

/// Um arquivo publicado no storage S3 (R2 em produção). O objeto mora no
/// bucket; aqui fica quem enviou, a que comunidade pertence e o estado.
/// Leitura só por URL assinada, emitida para quem pode ver o conteúdo.
model MediaFile {
  id          String      @id @default(uuid())
  /// Quem enviou. Nulo depois que a pessoa apaga a conta: o arquivo de uma
  /// comunidade é dela e fica.
  uploaderId  String?
  /// Comunidade dona do arquivo. Nulo = arquivo pessoal (Fase 8).
  groupId     String?
  /// Para que o arquivo foi enviado (`group_avatar`, `group_content`…). O
  /// item que o referencia confere que o propósito bate.
  purpose     String
  kind        MediaKind
  status      MediaStatus @default(PENDING)
  /// Chave do objeto no bucket.
  key         String      @unique
  mime        String
  bytes       Int
  width       Int?
  height      Int?
  createdAt   DateTime    @default(now())
  confirmedAt DateTime?

  uploader       User?                    @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  group          Group?                   @relation("GroupMedia", fields: [groupId], references: [id], onDelete: Cascade)
  groupAvatarOf  Group?                   @relation("GroupAvatar")
  agentAvatarOf  GroupAgent?              @relation("AgentAvatar")
  templateCovers GroupPlanTemplate[]      @relation("TemplateCover")
  tipImages      GroupTip[]               @relation("TipImage")
  guideVideoOf   GroupExerciseGuide?      @relation("GuideVideo")
  guidePhotoOf   GroupExerciseGuidePhoto?
  postImageOf    GroupPostImage?          @relation("PostImage")
  userAvatarOf   User?                    @relation("UserAvatar")
  mealPhotoOf    Meal?                    @relation("MealPhoto")

  /// Foto do chat (ADR 046): a mensagem da pessoa que a levou, e a ordem nela.
  /// `SetNull` e não `Cascade`: apagar a conversa apaga as mensagens no banco,
  /// e a linha da foto precisa sobreviver até o objeto sair do bucket. Quem
  /// varre é o `ConversationService.apagar`; a faxina de órfãos é a rede.
  chatMessageId String?
  chatPosition  Int?
  chatMessage   Message? @relation("ChatPhoto", fields: [chatMessageId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([uploaderId])
  @@index([chatMessageId])
  @@index([status, createdAt])
}

// ============================================================
// CONTEÚDO DA COMUNIDADE (Fase 7)
// ============================================================

enum PlanTemplateKind {
  WORKOUT
  NUTRITION
}

/// Plano pronto publicado pela equipe da comunidade. O conteúdo é um retrato
/// congelado (`snapshot`): treino no formato de `plan-snapshot.ts`, nutrição em
/// `nutrition-snapshot.ts`. Adotar copia para a conta do membro, e a cópia é
/// dele (ADR 014).
model GroupPlanTemplate {
  id              String           @id @default(uuid())
  groupId         String
  /// Nulo quando o autor apaga a conta: o plano é da comunidade.
  authorId        String?
  kind            PlanTemplateKind
  title           String
  description     String?
  /// "beginner" | "intermediate" | "advanced", como `Exercise.level`.
  level           String?
  coverFileId     String?
  snapshot        Json
  snapshotVersion Int
  /// Plano do autor de onde o treino foi congelado, para "atualizar a partir
  /// do plano". Sem chave estrangeira: é só conveniência do autor, e o plano
  /// dele pode sumir sem mexer no modelo publicado.
  sourcePlanId    String?
  /// Nulo = rascunho, visível só para a equipe.
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author        User?          @relation("PlanTemplateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  cover         MediaFile?     @relation("TemplateCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  workoutCopies WorkoutPlan[]  @relation("PlanFromTemplate")
  mealCopies    MealTemplate[] @relation("MealFromTemplate")

  @@index([groupId, publishedAt])
}

/// Dica publicada pela equipe da comunidade. Corpo em markdown restrito
/// (parágrafo, negrito, itálico, lista e link https), renderizado sem HTML.
model GroupTip {
  id          String    @id @default(uuid())
  groupId     String
  authorId    String?
  title       String
  body        String
  category    String
  imageFileId String?
  pinned      Boolean   @default(false)
  /// Nulo = rascunho, visível só para a equipe.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group  Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User?      @relation("TipAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  image  MediaFile? @relation("TipImage", fields: [imageFileId], references: [id], onDelete: SetNull)

  @@index([groupId, publishedAt])
}

/// O tutorial da comunidade para um exercício (Fase 7b, ADR 030): vídeo,
/// fotos e dicas dela por cima do exercício, seja do catálogo geral ou da
/// própria comunidade. É sobreposição, não cópia: o plano e o histórico de
/// quem treina continuam apontando para o mesmo `exerciseId`.
model GroupExerciseGuide {
  id          String   @id @default(uuid())
  groupId     String
  exerciseId  Int
  authorId    String?
  videoFileId String?  @unique
  /// Markdown restrito (`markdown-lite`), como as dicas.
  tips        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group    Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  exercise Exercise                  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  author   User?                     @relation("GuideAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  video    MediaFile?                @relation("GuideVideo", fields: [videoFileId], references: [id], onDelete: SetNull)
  photos   GroupExerciseGuidePhoto[]

  @@unique([groupId, exerciseId])
  @@index([exerciseId])
}

model GroupExerciseGuidePhoto {
  id      String @id @default(uuid())
  guideId String
  fileId  String @unique
  order   Int

  guide GroupExerciseGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  file  MediaFile          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([guideId])
}

/// O agente da comunidade no chat (Fase 7c, ADR 031): nome, avatar e
/// orientações de tom e foco, por cima do mesmo assistente. As orientações
/// entram cercadas no prompt, abaixo das regras fixas, e nunca mudam o que as
/// tools enxergam — elas continuam com o login de quem conversa.
model GroupAgent {
  groupId      String   @id
  name         String
  /// Até 2.000 caracteres, conferidos na API e no agente.
  instructions String   @default("")
  avatarFileId String?  @unique
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  avatarFile MediaFile? @relation("AgentAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
}

// ============================================================
// DESAFIOS DA COMUNIDADE (Fase 8a, ADR 027)
// ============================================================

/// O que um desafio mede. Atividade (as quatro primeiras) ou aderência à
/// PRÓPRIA meta, em dias (ADR 027) — nunca valor de corpo ou de alimentação.
/// A lista é a de `apps/api/src/social/challenge-metric.ts`, conferida em teste.
enum ChallengeMetric {
  WORKOUT_SESSIONS
  STEPS
  WATER_ML
  ACTIVE_DAYS
  KCAL_IN_RANGE_DAYS
  PROTEIN_TARGET_DAYS
  STREAK_DAYS
}

/// Um desafio que a equipe marca. A janela é única para todo participante, no
/// fuso da comunidade (`ScoreboardService`).
model GroupChallenge {
  id           String          @id @default(uuid())
  groupId      String
  /// Quem marcou. Sai da equipe ou apaga a conta: o desafio fica.
  authorId     String?
  title        String
  description  String?
  metric       ChallengeMetric
  /// Meia-noite do primeiro dia, no fuso da comunidade (inclusivo).
  startsAt     DateTime
  /// Virada do último dia (exclusivo). Encerrar antes grava o instante.
  endsAt       DateTime
  /// Fuso da comunidade quando o desafio foi marcado.
  timezone     String
  endedEarlyAt DateTime?
  /// Último recálculo do placar (recalcula na leitura quando fica velho).
  scoredAt     DateTime?
  /// Placar fechado e posições finais gravadas.
  finalizedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  group        Group                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author       User?                       @relation("ChallengeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  participants GroupChallengeParticipant[]

  @@index([groupId, endsAt])
  @@index([finalizedAt, endsAt])
}

/// Quem entrou no desafio (opt-in). A linha é a inscrição: sair apaga.
model GroupChallengeParticipant {
  id           String   @id @default(uuid())
  challengeId  String
  /// Pela associação, e não pelo usuário: sair da comunidade tira do placar.
  membershipId String
  /// Como a pessoa aparece no ranking.
  displayName  String
  /// Contagem da métrica. Nunca um valor de refeição ou de corpo (ADR 027).
  score        Int      @default(0)
  /// Posição gravada ao encerrar (empate divide a posição).
  finalRank    Int?
  joinedAt     DateTime @default(now())

  challenge  GroupChallenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([challengeId, membershipId])
  @@index([membershipId])
}

// ============================================================
// MURAL DA COMUNIDADE (Fase 8b)
// ============================================================

/// Quem publica no mural. Reagir, comentar e denunciar é de todo membro ativo.
enum PostPolicy {
  ALL_MEMBERS
  /// Só a equipe (dono, profissional, criador) publica.
  TEAM_ONLY
}

enum PostReactionKind {
  STRONG
  FIRE
  CLAP
  HEART
}

enum ReportReason {
  SPAM
  OFFENSIVE
  HARASSMENT
  /// Informação de saúde enganosa ou perigosa.
  MISINFORMATION
  OTHER
}

/// Um post no mural. O autor é a associação, e não a conta: o apelido e o selo
/// de equipe saem dela, e apagar a conta apaga o post junto (cascata).
/// Removido pela moderação continua aqui, visível só ao autor (ADR 032).
model GroupPost {
  id            String        @id @default(uuid())
  groupId       String
  membershipId  String
  /// Markdown-lite, até 2000 caracteres. Pode ser vazio quando há imagem.
  body          String
  pinnedAt      DateTime?
  removedAt     DateTime?
  removedById   String?
  removedReason ReportReason?
  createdAt     DateTime      @default(now())

  group     Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    GroupMembership     @relation("PostAuthor", fields: [membershipId], references: [id], onDelete: Cascade)
  removedBy GroupMembership?    @relation("PostRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  images    GroupPostImage[]
  reactions GroupPostReaction[]
  comments  GroupPostComment[]
  reports   GroupPostReport[]

  @@index([groupId, createdAt])
  @@index([groupId, pinnedAt])
  @@index([membershipId])
}

/// Até quatro imagens por post (mídia `post_image`, ADR 028).
model GroupPostImage {
  id     String @id @default(uuid())
  postId String
  fileId String @unique
  order  Int

  post GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  file MediaFile @relation("PostImage", fields: [fileId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// Uma reação por pessoa por post; trocar de reação troca o `kind`.
model GroupPostReaction {
  id           String           @id @default(uuid())
  postId       String
  membershipId String
  kind         PostReactionKind
  createdAt    DateTime         @default(now())

  post       GroupPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([postId, membershipId])
  @@index([membershipId])
}

/// Comentário: texto puro, até 500 caracteres.
model GroupPostComment {
  id           String    @id @default(uuid())
  postId       String
  membershipId String
  body         String
  removedAt    DateTime?
  removedById  String?
  createdAt    DateTime  @default(now())

  post      GroupPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    GroupMembership   @relation("CommentAuthor", fields: [membershipId], references: [id], onDelete: Cascade)
  removedBy GroupMembership?  @relation("CommentRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  reports   GroupPostReport[]

  @@index([postId, createdAt])
  @@index([membershipId])
}

/// Denúncia de um post (ou de um comentário dele). Quem denunciou não aparece
/// para a equipe; a linha serve à fila e à trilha da decisão.
model GroupPostReport {
  id           String       @id @default(uuid())
  postId       String
  commentId    String?
  reporterId   String
  reason       ReportReason
  note         String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  /// "removed" | "dismissed"
  resolution   String?

  post       GroupPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    GroupPostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   GroupMembership   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy GroupMembership?  @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([postId, resolvedAt])
  @@index([commentId])
  @@index([reporterId])
}

// ============================================================
// Avisos no celular (Fase 8c, ADR 033)
// ============================================================

enum DevicePlatform {
  IOS
  ANDROID
}

/// O que cada aviso cobre; a pessoa desliga por tipo (prancha Al-V4, #389).
/// O padrão de cada tipo, quando não há linha em `NotificationPreference`,
/// está em `NOTIFICATION_DEFAULTS` (`notification.service.ts`): o grupo
/// "Opcional" nasce desligado.
enum NotificationKind {
  COMMUNITY
  CHALLENGES
  FEED
  MODERATION
  /// A resposta do chat ficou pronta com o app fora de vista (Fase 9e).
  CHAT
  /// O que a equipe manda para todos (#394). Separado dos lembretes (Apple 4.5.4).
  ANNOUNCEMENTS
  /// Treino ou alimentação enviados para a pessoa pela equipe.
  PLAN_RECEIVED
  /// A equipe pediu uma avaliação, com prazo (#383).
  ASSESSMENT_REQUESTED
  /// Perguntas depois do treino ou da semana (#391).
  QUESTIONNAIRE
  /// Agenda da comunidade: evento novo ou mudança de horário (#397).
  SCHEDULE
  /// Treino do dia, 1 h antes, quando a comunidade tem agenda (#397).
  SCHEDULE_REMINDER
  /// Parabéns da comunidade no dia do aniversário. "Opcional": nasce desligado.
  BIRTHDAY
  /// Os lembretes pessoais (`Reminder`). Sem chave na tela: cada lembrete tem a sua.
  REMINDERS
}

/// Um celular em que a pessoa ligou os avisos. O token é da Expo e é único: o
/// mesmo aparelho em outra conta passa para quem registrou por último.
model UserDevice {
  id         String         @id @default(uuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  /// Última vez que o app abriu e refez o cadastro.
  lastSeenAt DateTime       @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets PushTicket[]

  @@index([userId, lastSeenAt])
}

/// Um envio que a Expo aceitou e cujo recibo ainda não foi lido (Fase 9g). O
/// recibo diz se a Apple ou o Google entregaram; `DeviceNotRegistered` nele
/// apaga o aparelho. Vive no máximo 24 h.
model PushTicket {
  /// O id do ticket da Expo.
  id        String   @id
  deviceId  String
  createdAt DateTime @default(now())

  device UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// Avisos em sequência viram um só (Fase 9g): o primeiro comentário num post
/// avisa na hora; os seguintes, dentro da janela, saem juntos no fim dela.
model PendingNotice {
  /// O que agrupa, ex. `comment:<postId>`.
  key          String
  userId       String
  kind         NotificationKind
  /// Quantos chegaram depois do aviso que já saiu.
  count        Int              @default(0)
  /// Nome da comunidade e caminho do toque — nada do conteúdo.
  community    String
  url          String
  /// Nome de quem agiu por último, para "Helena e mais 3 reagiram ao seu post" (Ex-06, #389).
  actor        String?
  windowEndsAt DateTime
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([key, userId])
  @@index([windowEndsAt])
}

/// Um navegador em que a pessoa ligou os avisos (Web Push, Fase 9g). O endpoint
/// é do serviço de push do navegador e é único.
model WebPushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

/// Só existe linha para o tipo que a pessoa mexeu; sem linha, está ligado.
model NotificationPreference {
  userId    String
  kind      NotificationKind
  enabled   Boolean
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

/// A central de avisos do sino no Hoje (#373): cada aviso que a pessoa recebeu,
/// para rever depois. É gravado junto do envio (`NotificationService`), com o
/// mesmo título e texto do push — que já nascem sem dado de saúde, porque
/// aparecem na tela bloqueada. Vale para todo tipo menos `CHAT`: a resposta do
/// chat pronta é aviso de momento, e quem quer a resposta abre a conversa.
///
/// Preferência desligada corta o push, não a linha: a central é o lugar de ver
/// o que chegou sem ser interrompido. Linhas com mais de 90 dias saem na próxima
/// gravação para a pessoa (`DATA_RETENTION.md`).
model InboxNotice {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  /// Caminho do toque, o mesmo do push.
  url       String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ============================================================
// Lembretes pessoais (#389)
// ============================================================

/// Do que o lembrete lembra (prancha Al-V3). Cada tipo, menos o hábito, é
/// conferido no servidor antes de sair: água batida, refeição registrada,
/// treino feito, pesagem do dia, passos acima da meta.
enum ReminderKind {
  WATER
  MEAL
  WEIGHT
  WORKOUT
  STEPS
  /// Hábito (#390). Aceito quando os hábitos existirem; até lá a API recusa.
  HABIT
}

enum ReminderMode {
  /// "A cada N h" entre `fromMinute` e `toMinute`.
  INTERVAL
  /// Horários fixos em `times`.
  TIMES
}

/// Um lembrete pessoal (Você › Lembretes). Dado da pessoa: entra no export,
/// morre com a conta e a equipe não vê. Horários em minutos do dia no fuso de
/// `User.timezone`.
model Reminder {
  id         String       @id @default(uuid())
  userId     String
  kind       ReminderKind
  /// O hábito do lembrete de hábito (#390). Sem FK até a tabela existir.
  habitId    String?
  mode       ReminderMode
  /// Só no `INTERVAL`: de 1 a 6 horas.
  everyHours Int?
  fromMinute Int?
  toMinute   Int?
  /// Só no `TIMES`: minutos do dia, em ordem e sem repetir.
  times      Int[]        @default([])
  /// Dias da semana ISO (1 = segunda … 7 = domingo).
  weekdays   Int[]
  /// Passos: só lembra se o dia estiver abaixo disto ("se abaixo de 6 mil").
  stepsBelow Int?
  enabled    Boolean      @default(true)
  /// Último envio pelo servidor; evita mandar o mesmo horário duas vezes.
  lastSentAt DateTime?
  /// Dia (YYYY-MM-DD, fuso da pessoa) e quantos saíram nele: o teto por dia.
  sentDate   String?
  sentCount  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([enabled])
}
