// Fatia — Prisma schema
// Documentação: ../../../docs/ARCHITECTURE.md
// Decisões: ../../../docs/ADR/

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id        String   @id @default(uuid())
  // Sub claim do JWT do Logto. Identidade externa estável (ver ADR 008).
  logtoSub  String   @unique
  email     String   @unique
  name      String
  role      Role     @default(USER)
  timezone  String   @default("America/Sao_Paulo")
  heightCm  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals           UserGoals?
  personalGoals   Goal[]
  meals           Meal[]
  workoutPlans    WorkoutPlan[]
  workoutSessions WorkoutSession[]
  weightLogs      WeightLog[]
  stepLogs        StepLog[]
  waterLogs       WaterLog[]
  customFoods     Food[]            @relation("UserCustomFoods")
  customExercises Exercise[]        @relation("UserCustomExercises")
  nutrientTargets NutrientTarget[]
  achievements    UserAchievement[]
  trainingBlocks  TrainingBlock[]

  conversations Conversation[]
  aiUsage       AiUsage[]

  // B2B (ADR 014). Nenhuma destas relações dá acesso a dado de saúde por si só —
  // quem autoriza leitura é exclusivamente uma linha de `ProfessionalLink`.
  ownedGroups         Group[]                 @relation("GroupOwner")
  memberships         GroupMembership[]
  linksAsSubject      ProfessionalLink[]      @relation("LinkSubject")
  linksAsProfessional ProfessionalLink[]      @relation("LinkProfessional")
  accessLogs          ProfessionalAccessLog[] @relation("AccessLogSubject")

  @@index([logtoSub])
}

enum Role {
  USER
  ADMIN
}

// OAuth facade pro MCP: Logto não expõe DCR público, então a API age
// como AS público (DCR + authorize/token) e federa pro Logto internamente.
model McpOAuthClient {
  id           String    @id @default(uuid())
  clientId     String    @unique
  clientName   String?
  redirectUris String[]
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  authorizations McpOAuthAuthorization[]
}

model McpOAuthAuthorization {
  id                  String    @id @default(uuid())
  // State que mandamos pro Logto — usado no /oauth/callback
  state               String    @unique
  // Code que devolvemos pro cliente MCP (Claude) — preenchido no callback
  code                String?   @unique
  clientId            String
  redirectUri         String
  // State original do cliente MCP — relayed no redirect final
  clientState         String?
  // PKCE enviado pelo cliente MCP — verificado no /oauth/token
  clientCodeChallenge String
  // PKCE que nós usamos com o Logto — usado no token exchange downstream
  logtoCodeVerifier   String
  // Code recebido do Logto no /oauth/callback
  logtoCode           String?
  // resource indicator (RFC 8707), se enviado
  resource            String?
  scope               String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  client McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model UserGoals {
  userId             String   @id
  kcalMin            Int
  kcalMax            Int
  proteinMinG        Int
  proteinMaxG        Int
  carbsMinG          Int
  carbsMaxG          Int
  fatMinG            Int
  fatMaxG            Int
  weeklyWorkouts     Int      @default(3)
  dailyStepsTarget   Int      @default(8000)
  dailyWaterTargetMl Int      @default(2500)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// NUTRITION
// ============================================================

model FoodGroup {
  id   Int    @id @default(autoincrement())
  name String @unique // "cereais", "leguminosas", "carnes", "frutas", etc

  foods     Food[]
  mealItems MealItem[]
}

model Food {
  id              Int        @id @default(autoincrement())
  name            String
  source          FoodSource
  groupId         Int?
  // Para CUSTOM foods: dono. Null para TACO/USDA (catálogo público).
  createdByUserId String?
  kcalPer100g     Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  // Micronutrientes por 100g (catálogo), mapa flexível: { "sodium_mg": 1.2, "fiber_g": 2.7 }.
  // Derivado por regra de 3 para MealItem.nutrients ao logar (ADR 009).
  nutrients       Json?
  // Nome reduzido à forma comparável (minúsculo, sem acento, sem pontuação).
  // Existe porque `contains` no `name` não acha "feijao" para "Feijão" — e no
  // teclado do celular ninguém acentua. Mantido por `FoodService`; ver
  // `apps/api/src/common/search-text.ts`.
  searchName      String     @default("")
  createdAt       DateTime   @default(now())

  group     FoodGroup? @relation(fields: [groupId], references: [id])
  createdBy User?      @relation("UserCustomFoods", fields: [createdByUserId], references: [id], onDelete: Cascade)
  mealItems MealItem[]

  // Unicidade por (nome, source) só para públicos. Customs podem repetir nomes
  // entre usuários — unicidade real é (nome, source, createdByUserId).
  @@unique([name, source, createdByUserId])
  @@index([searchName])
  @@index([name])
  @@index([source])
  @@index([createdByUserId])
}

enum FoodSource {
  TACO
  USDA
  CUSTOM
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Meal {
  id        String   @id @default(uuid())
  userId    String
  mealType  MealType
  eatenAt   DateTime
  notes     String?
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId, eatenAt])
}

model MealItem {
  id        String @id @default(uuid())
  mealId    String
  foodId    Int? // null = item livre estimado pelo Claude
  groupId   Int? // copiado do food, ou inferido pelo Claude
  foodName  String // snapshot — sempre preenchido
  grams     Float
  kcal      Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  // Micronutrientes opcionais (snapshot), mapa flexível: { "sodium_mg": 412, "sugar_g": 9 }.
  // Json em vez de colunas fixas: nutrientes são open-ended e a TACO não cobre todos
  // (ADR 009). Ausente = não rastreado para aquele item.
  nutrients Json?

  meal  Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food  Food?      @relation(fields: [foodId], references: [id])
  group FoodGroup? @relation(fields: [groupId], references: [id])

  @@index([mealId])
}

// ============================================================
// WORKOUT
// ============================================================

model Exercise {
  id               Int      @id @default(autoincrement())
  name             String
  // Ver `Food.searchName` — mesma razão, mantido por `ExerciseService`.
  searchName       String   @default("")
  muscleGroup      String // "peito", "costas", "pernas", "ombro", "braço", "core", "cardio"
  // Defaults `[]` espelham o `DEFAULT '{}'` criado em
  // migrations/20260602120000_add_exercise_enrichment. Sem eles o datamodel
  // divergia do banco e o job `Prisma Checks` do CI acusava drift.
  primaryMuscles   String[] @default([])
  secondaryMuscles String[] @default([])
  equipment        String?
  level            String? // "beginner" | "intermediate" | "advanced"
  mechanic         String? // "compound" | "isolation"
  instructions     String[] @default([])
  youtubeVideoId   String?
  youtubeVideoIdPt String?
  // Para exercícios custom: dono. Null = catálogo público.
  createdByUserId  String?
  // Se esta é uma cópia editável de um exercício base, aponta para o base de origem.
  // A base correspondente é escondida das listagens do usuário (a cópia a substitui).
  clonedFromId     Int?
  createdAt        DateTime @default(now())

  createdBy     User?                 @relation("UserCustomExercises", fields: [createdByUserId], references: [id], onDelete: Cascade)
  clonedFrom    Exercise?             @relation("ExerciseClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones        Exercise[]            @relation("ExerciseClones")
  planExercises WorkoutPlanExercise[]
  sessionSets   SessionSet[]

  @@unique([name, createdByUserId])
  @@index([name])
  @@index([searchName])
  @@index([muscleGroup])
  @@index([createdByUserId])
  @@index([clonedFromId])
}

model WorkoutPlan {
  id        String   @id @default(uuid())
  userId    String
  name      String // "Push", "Pull", "Leg"
  createdAt DateTime @default(now())

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises      WorkoutPlanExercise[]
  sessions       WorkoutSession[]
  trainingBlocks TrainingBlock[]

  @@index([userId])
}

model WorkoutPlanExercise {
  id         String @id @default(uuid())
  planId     String
  exerciseId Int
  order      Int
  targetSets Int
  targetReps String // "8-12", "5", "AMRAP" — string pra flexibilidade

  plan     WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id])

  @@unique([planId, exerciseId])
  @@index([planId])
}

model WorkoutSession {
  id          String    @id @default(uuid())
  userId      String
  planId      String? // null = treino livre
  startedAt   DateTime
  completedAt DateTime?
  notes       String?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan WorkoutPlan? @relation(fields: [planId], references: [id])
  sets SessionSet[]

  @@index([userId, startedAt])
}

model SessionSet {
  id         String @id @default(uuid())
  sessionId  String
  exerciseId Int
  setNumber  Int

  // Campos de força — opcionais pois SessionSet também cobre cardio
  weightKg Float?
  reps     Int?
  rpe      Float? // 1-10, opcional

  // Campos de cardio — opcionais pois também cobre força
  durationSeconds Int?
  distanceMeters  Float?
  avgHeartRate    Int?
  kcalBurned      Int?

  notes String?

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([sessionId])
  @@index([exerciseId])
}

// ============================================================
// PERIODIZAÇÃO (#145 — ADR 019)
// ============================================================

/// Bloco de periodização: 4 semanas (3 de acúmulo/pico + 1 deload) sobre um plano.
///
/// O que estas tabelas guardam é **intenção**, e só ela: o bloco que o usuário
/// aceitou, com os multiplicadores congelados no dia em que aceitou. Derivar a
/// intenção do histórico faria a semana mudar sozinha no dia em que o template do
/// código mudasse, e não haveria o que explicar a quem está no meio do bloco.
///
/// O que **não** mora aqui é o andamento — sessões feitas, semanas empurradas,
/// bloco vencido ou abandonado por ausência. Isso é função pura do histórico de
/// `WorkoutSession` e é recalculado em toda leitura (`helpers/reconcile-block.ts`).
/// Guardar contador de andamento criaria uma cópia que mente sozinha quando uma
/// sessão é apagada ou registrada retroativamente — e obrigaria a gravar durante
/// um `GET`, que é o que `get_training_block` promete não fazer (`readOnlyHint`).
model TrainingBlock {
  id     String  @id @default(uuid())
  userId String
  planId String?

  kind       TrainingBlockKind   @default(hypertrophy)
  /// YYYY-MM-DD no fuso do usuário, mesma escolha de `StepLog.date`.
  startDate  String
  weeksTotal Int                 @default(4)
  status     TrainingBlockStatus @default(active)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan  WorkoutPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  weeks TrainingBlockWeek[]

  @@index([userId, status])
}

model TrainingBlockWeek {
  id         String @id @default(uuid())
  blockId    String
  /// 1..weeksTotal
  weekNumber Int
  /// "accumulation" | "peak" | "deload"
  focus      String

  /// Multiplicadores gravados na linha, não lidos do template do código: um bloco
  /// em curso não pode mudar debaixo do usuário quando o template mudar.
  ///
  /// Consequência para quem depura: ver 1.025 aqui e 1.05 em `block-template.ts`
  /// **não** é bug — é um bloco criado antes da mudança do template.
  intensityFactor Float
  volumeFactor    Float

  /// Segunda-feira **planejada** da semana, YYYY-MM-DD — o combinado, não o que
  /// aconteceu. A reancoragem por semana perdida sai derivada na leitura
  /// (`effectiveWeekStart`); esta coluna nunca é reescrita.
  weekStart      String
  sessionsTarget Int

  block TrainingBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, weekNumber])
  @@index([blockId])
}

enum TrainingBlockKind {
  strength
  hypertrophy
}

enum TrainingBlockStatus {
  active
  completed
  abandoned
}

// ============================================================
// STEPS
// ============================================================

model StepLog {
  id       String     @id @default(uuid())
  userId   String
  // YYYY-MM-DD no fuso do usuário. String pra evitar ambiguidade de timezone.
  date     String
  steps    Int
  source   StepSource @default(MANUAL)
  loggedAt DateTime   @default(now())
  notes    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Múltiplos logs por dia permitidos (várias fontes, correções, sync parcial).
  // Política de "valor do dia" definida em ADR 007: maior valor entre os logs
  // do dia. Implementada em StepLogService.getStepsForDate.
  @@index([userId, date])
  @@index([userId, loggedAt])
}

enum StepSource {
  MANUAL
  GOOGLE_FIT
  APPLE_HEALTH
  HEALTH_CONNECT
  STRAVA
  GARMIN
  FITBIT
  WEBHOOK
}

// ============================================================
// PROGRESS
// ============================================================

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  weightKg  Float
  loggedAt  DateTime
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// Hidratação. Múltiplos logs por dia esperados (cada copo é um log).
// Política do "valor do dia" = SOMA (diferente de StepLog, que é MAX).
model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  // YYYY-MM-DD no fuso do usuário.
  date     String
  ml       Int
  loggedAt DateTime @default(now())
  notes    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, loggedAt])
}

// ============================================================
// ENGAJAMENTO
// ============================================================

// Conquista desbloqueada. Guarda só o fato e a data — a definição (título,
// critério, ícone) vive em código, em `achievement-catalog.ts`. Guardar a
// definição no banco obrigaria migration a cada conquista nova e deixaria duas
// versões da mesma conquista coexistindo.
//
// Streak NÃO tem tabela: continua derivado de Meal/WorkoutSession/StepLog. Uma
// tabela criaria um segundo lugar onde a verdade mora — apagar uma refeição
// teria de decrementar o contador, e errar isso é invisível.
model UserAchievement {
  id String @id @default(uuid())

  userId String
  // Chave do catálogo: "first_meal", "first_workout", "first_pr", ...
  key    String

  unlockedAt DateTime @default(now())

  // Contexto do desbloqueio, para a tela contar a história:
  // `{ "weightKg": 80 }`. Json porque cada conquista tem um contexto diferente
  // — mesma razão de `MealItem.nutrients` (ADR 009).
  context Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uma vez só por usuário. É o que torna a reavaliação idempotente.
  //
  // Sem `@@index([userId])`: o unique composto já é um índice com `userId` à esquerda, e é ele
  // que atende o `findMany where userId` da listagem. Um índice só de `userId` seria pago em
  // toda escrita sem servir a nenhuma consulta que o composto não sirva.
  @@unique([userId, key])
}

// ============================================================
// PERSONAL GOALS
// ============================================================

// Metas dinâmicas definíveis pelo usuário (via PWA ou Claude/MCP).
// Distintas de `UserGoals` (que cobre só macros nutricionais).
// `currentValue` é derivado em tempo de leitura quando `kind` tem fonte
// (weight, workout_frequency, step_count). Para `body_fat` e `custom`,
// o Claude reporta valores via `lastReportedValue`.
model Goal {
  id                String     @id @default(uuid())
  userId            String
  kind              GoalKind
  title             String
  description       String?
  startValue        Float
  targetValue       Float
  unit              String
  // Reportado pelo Claude para metas sem fonte automática (body_fat, custom).
  lastReportedValue Float?
  deadline          DateTime?
  status            GoalStatus @default(active)
  createdAt         DateTime   @default(now())
  completedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, kind])
}

enum GoalKind {
  weight
  body_fat
  workout_frequency
  step_count
  custom
}

// Metas de nutrientes personalizadas (ex.: limitar sódio, açúcar; atingir fibra).
// Distintas de `UserGoals` (macros fixos). Min/max em range (ADR 006/D6). O valor
// do dia é agregado de `MealItem.nutrients[nutrientKey]`. Ver ADR 009.
model NutrientTarget {
  id          String   @id @default(uuid())
  userId      String
  nutrientKey String // "sodium_mg", "sugar_g", "fiber_g", "caffeine_mg", ...
  label       String // "Sódio", "Açúcar"
  unit        String // "mg", "g"
  min         Float?
  max         Float?
  period      String   @default("daily") // v1: apenas "daily"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nutrientKey])
  @@index([userId])
}

enum GoalStatus {
  active
  completed
  expired
  archived
}

// ============================================================
// B2B — GRUPOS E VÍNCULO PROFISSIONAL (ADR 014)
// ============================================================
//
// Regra que governa este bloco inteiro: **estar num grupo, em qualquer papel,
// não dá acesso a nenhum dado de saúde de ninguém**. Papel governa administração
// de grupo. Leitura entre contas vem exclusivamente de uma linha de
// `ProfessionalLink` que o próprio titular criou, e passa por um único método
// (`ProfessionalAccessService.assertReadable`). É o que mantém os services de
// domínio — meal, workout, weight, steps, water, goals — inconscientes de que
// grupo existe.

enum GroupType {
  /// Academia paga a IA dos alunos. Único tipo que gera cobrança (#158).
  SPONSORED
  /// Criador de conteúdo / influenciador. Ninguém paga IA.
  SOCIAL
}

enum GroupRole {
  /// Gere grupo, membros e cobrança. NÃO lê dado de saúde de ninguém.
  OWNER
  /// Pode receber vínculo de leitura e oferecer plano. Só isso.
  PROFESSIONAL
  /// Publica conteúdo no grupo social. Nunca lê dado individual.
  CREATOR
  /// Aluno/fã. O próprio dado, sempre.
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  LEFT
  REMOVED
}

/// Categorias de dado que podem ser consentidas, independentes entre si.
/// A ADR 014 nomeia treino, nutrição, peso e passos; a #155 pede também metas.
/// O enum é o superconjunto — nenhuma delas implica outra.
enum ShareScope {
  WORKOUT
  NUTRITION
  /// Peso e medidas corporais.
  BODY
  /// Água e passos.
  HABITS
  GOALS
}

model Group {
  id        String    @id @default(uuid())
  type      GroupType
  name      String
  /// Usado no link de convite e na URL do painel. Público por natureza.
  slug      String    @unique
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Cascade e não Restrict de propósito: com Restrict, `delete_my_account` de um
  // dono de academia falharia — um direito da LGPD travado por dívida comercial.
  // Apagar a conta do dono apaga grupo, memberships e vínculos, e **nenhum dado
  // de aluno é tocado**, porque nunca esteve sob o grupo. Fatura em aberto é
  // problema da #158, não deste FK.
  owner       User               @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  links       ProfessionalLink[]

  @@index([ownerId])
  @@index([type])
}

model GroupMembership {
  id        String           @id @default(uuid())
  groupId   String
  userId    String
  role      GroupRole
  status    MembershipStatus @default(INVITED)
  invitedAt DateTime         @default(now())
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Um papel por pessoa por grupo. É o que torna estruturalmente impossível
  // o acúmulo de papéis que a #156 pede para evitar: não existe linha em que
  // alguém seja OWNER e PROFESSIONAL do mesmo grupo.
  @@unique([groupId, userId])
  @@index([userId, status])
  @@index([groupId, status])
  @@index([groupId, role])
}

/// A ÚNICA autorização de leitura entre contas do produto (ADR 014).
/// Tabela, e não colunas em `User`: duas colunas assumiriam para sempre no
/// máximo um profissional por pessoa, e corrigir isso depois seria migration
/// de dado sobre permissão de leitura de dado de saúde.
model ProfessionalLink {
  id             String       @id @default(uuid())
  /// Titular do dado. Quem consente — e a única pessoa que pode consentir.
  subjectUserId  String
  /// Quem passa a poder ler. Nunca inferido de papel: sempre gravado aqui.
  professionalId String
  /// Contexto. Sair do grupo revoga todo vínculo com este `groupId`.
  groupId        String
  /// Consentimento por categoria. Vazio é estado válido e significa nada.
  scopes         ShareScope[]
  grantedAt      DateTime     @default(now())
  /// Revogação NÃO apaga a linha — é o que responde "quem teve acesso a quê,
  /// quando", que o THREAT_MODEL hoje lista como ausência conhecida.
  revokedAt      DateTime?
  /// "subject" | "group_owner" | "left_group" | "membership_removed" | "superseded"
  revokedReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subject      User                    @relation("LinkSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  professional User                    @relation("LinkProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  group        Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accessLogs   ProfessionalAccessLog[]

  // Sem @@unique em (subject, professional, group): conceder de novo depois de
  // revogar cria linha NOVA. Unicidade forçaria UPDATE e destruiria a trilha —
  // é a "correção" errada mais provável numa revisão futura.
  @@index([professionalId, revokedAt])
  @@index([subjectUserId, revokedAt])
  @@index([groupId, revokedAt])
}

/// Trilha de auditoria. Escrita em UM lugar só (`ProfessionalAccessService`),
/// inclusive nas negativas — "tentou ver o que não podia" é o registro que mais
/// importa.
model ProfessionalAccessLog {
  id             String     @id @default(uuid())
  /// Nulo quando não havia vínculo (negativa) ou quando o vínculo sumiu junto
  /// com a conta do profissional. A trilha do titular sobrevive aos dois casos.
  linkId         String?
  /// String pura, sem FK: se o profissional apagar a conta, o aluno continua
  /// conseguindo responder "quem olhou meu dado".
  professionalId String
  subjectUserId  String
  scope          ShareScope
  /// Vocabulário do produto: "list_workout_sessions", "get_student_progress".
  action         String
  denied         Boolean    @default(false)
  at             DateTime   @default(now())

  link    ProfessionalLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  subject User              @relation("AccessLogSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([subjectUserId, at])
  @@index([professionalId, at])
  @@index([linkId, at])
}

// ============================================================
// CHAT COM IA HOSPEDADA (#247, #249)
// ============================================================

/// Uma conversa do usuário com a IA hospedada. O histórico mora **aqui**, e não
/// no agente: o `apps/agent` não tem credencial de Postgres e não vai ter
/// (ADR 015), então quem guarda é quem já é dono do isolamento.
model Conversation {
  id     String  @id @default(uuid())
  userId String
  /// Derivado da primeira mensagem, para a lista de conversas ter o que mostrar.
  /// Nulo até o primeiro turno completar.
  title  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  /// A listagem é sempre "minhas conversas, mais recente primeiro".
  @@index([userId, updatedAt])
}

/// Papel de quem falou. Minúsculo e com estes dois nomes de propósito: é o
/// vocabulário que o agente já usa no corpo da requisição, então não existe
/// tradução entre a linha do banco e o que viaja — e tradução entre camadas foi
/// exatamente o que custou caro na #157.
enum MessageRole {
  user
  assistant
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  /// Quais tools o agente chamou neste turno, na ordem, como `[{ "name": "log_meal" }]`.
  /// Existe para que a ação continue auditável **depois de recarregar a página** —
  /// sem isso, "o agente registrou uma refeição" só aparece durante o streaming e
  /// some no F5, que é o oposto de auditável.
  ///
  /// Só o nome, e não o payload da tool: o argumento de uma chamada carrega dado
  /// de saúde e já está persistido no domínio de destino. Guardar de novo aqui
  /// criaria uma segunda cópia, com retenção própria, de dado que o usuário apaga
  /// no lugar certo.
  tools          Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// **Sem `userId` aqui, de propósito.** O dono é a conversa, e uma segunda
  /// coluna de dono é uma segunda verdade que pode divergir da primeira — o
  /// caminho mais curto para uma escrita entre contas do tipo da #204. Toda
  /// leitura e escrita de mensagem passa por um `conversationId` que o
  /// `ConversationService` já amarrou ao `userId` verificado.
  @@index([conversationId, createdAt])
}

/// Livro-caixa da inferência que a **Fatia** paga (#135).
///
/// A lógica da cota já existia em `apps/api/src/ai/ai-quota.ts` desde a #135, sem
/// nada que somasse o gasto — `nutrition/inference-throttler.guard.ts` registra a
/// ausência com todas as letras. Esta tabela é essa soma, e é ela que faz
/// `assertAiQuota` ser reuso e não um segundo mecanismo de cota.
///
/// O que **não** entra aqui: chamada que sai do Claude do próprio usuário pelo
/// `/mcp`. Aquele custo é dele, não nosso (ADR 018).
model AiUsage {
  id String @id @default(uuid())

  /// Nulo quando a conta foi apagada — ver `onDelete: SetNull` abaixo.
  userId  String?
  /// Qual caminho gastou: "chat" hoje; visão e áudio quando a #139/#141 passarem
  /// a registrar. Serve para o operador saber onde o orçamento foi, e não muda
  /// nenhuma decisão de cota — o teto é do dia inteiro, somando tudo.
  feature String
  /// Modelo que o agente reportou. String vazia quando ele não reportou nada, que
  /// é o caso em que `pricingKnown` nasce falso.
  model   String

  /// Micro-unidades da moeda, inteiro. Ver `ai-pricing.ts` para a escala.
  costMicros   Int
  /// `false` = este custo **não foi medido**, e o `0` ao lado não significa
  /// "grátis". É o que impede a cota de se desligar sozinha e em silêncio quando
  /// a medição se perde (`AiQuotaSpend.unpricedCalls`).
  pricingKnown Boolean

  createdAt DateTime @default(now())

  /// `SetNull`, e não `Cascade`: o teto **global** do dia mede dinheiro que já
  /// saiu do caixa, e apagar a conta não desfaz a fatura. Com `Cascade`, quem
  /// gastasse o orçamento da instância e apagasse a conta em seguida devolveria a
  /// cota global ao zero. A linha órfã não guarda nada pessoal — id, papel e
  /// conteúdo vão embora com o usuário; aqui fica um custo e um modelo.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Os dois `where` da janela: o do usuário e o da instância inteira.
  @@index([userId, createdAt])
  @@index([createdAt])
}
