{
  "name": "@fatia/design",
  "version": "0.1.0",
  "private": true,
  "description": "Design system v2 \"Noite\": tokens, contraste, cor de marca, ícones, movimento e o relógio dos circuitos, compartilhados por app, web, site e API.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "css": "tsc -p tsconfig.build.json && node scripts/print-css.cjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
